//@version=5
// AT24 Regime Pulse - Know WHEN to trade, not just where.
// Trend quality (Efficiency Ratio) + volatility rank (ATR percentile) + spread cost + session.
// Context tool. Not a signal. algotraders24.ai
indicator("AT24 Regime Pulse", shorttitle="AT24 RP", overlay=false, max_bars_back=1000)

grp1 = "Measurements"
erLen   = input.int(20, "Efficiency Ratio period", minval=2, group=grp1)
atrLen  = input.int(14, "ATR period", minval=2, group=grp1)
lookbk  = input.int(500, "Volatility rank lookback (bars)", minval=20, maxval=1000, group=grp1)
grp2 = "Regime thresholds"
erTrend = input.float(0.35, "ER at/above = trending", step=0.01, group=grp2)
erRange = input.float(0.20, "ER at/below = ranging", step=0.01, group=grp2)
pctHigh = input.float(70.0, "ATR rank at/above = high volatility", group=grp2)
pctQuiet= input.float(25.0, "ATR rank at/below = quiet", group=grp2)
grp3 = "Cost"
spreadIn = input.float(0.0, "Typical spread (price units, 0 = hide cost row)", step=0.01, group=grp3)
maxCost  = input.float(0.15, "Warn when spread / ATR is above", step=0.01, group=grp3)
grp4 = "Dashboard"
showDash = input.bool(true, "Show dashboard", group=grp4)
dashPos  = input.string("top right", "Position", options=["top left","top right","bottom left","bottom right"], group=grp4)
grp5 = "Alerts"
alertOn  = input.bool(true, "Enable regime-change alert condition", group=grp5)

// ---- measurements
netMove = math.abs(close - close[erLen])
path    = math.sum(math.abs(close - close[1]), erLen)
er      = path > 0 ? netMove / path : 0.0
atr     = ta.rma(ta.tr(true), atrLen)
rank    = ta.percentrank(atr, lookbk) // share of the previous bars with a lower ATR (0..100)

// ---- regime: 1 TREND, 2 STRONG, 3 RANGE, 4 CHOP, 5 QUIET, 6 MIXED
regime = na(rank) ? 0 : rank <= pctQuiet ? 5 : er >= erTrend ? (rank >= pctHigh ? 2 : 1) : er <= erRange ? (rank >= pctHigh ? 4 : 3) : 6
regName = switch regime
    1 => "TREND"
    2 => "STRONG TREND"
    3 => "RANGE"
    4 => "CHOP (volatile range)"
    5 => "QUIET"
    6 => "MIXED"
    => "..."
regCol = switch regime
    1 => color.new(color.lime, 0)
    2 => color.new(color.aqua, 0)
    3 => color.new(color.orange, 0)
    4 => color.new(color.red, 0)
    5 => color.new(color.gray, 0)
    6 => color.new(color.yellow, 0)
    => color.new(color.gray, 60)

// ---- session label (exchange time zone independent: uses UTC)
utcMin = hour(time, "UTC") * 60 + minute(time, "UTC")
sess = (utcMin >= 1290 and utcMin < 1410) ? "ROLLOVER (wide spread)" : (utcMin >= 780 and utcMin < 960) ? "LONDON/NY OVERLAP" : (utcMin >= 420 and utcMin < 780) ? "LONDON" : (utcMin >= 960 and utcMin < 1290) ? "NEW YORK" : "ASIA"

// ---- plots
plot(er * 100, "Trend quality (ER x100)", color=regCol, style=plot.style_histogram, linewidth=3)
plot(rank, "Volatility rank", color=color.new(#E8B84A, 0), linewidth=1)
hline(erTrend * 100, "Trend line", color=color.new(color.gray, 60), linestyle=hline.style_dotted)
hline(erRange * 100, "Range line", color=color.new(color.gray, 60), linestyle=hline.style_dotted)

// ---- dashboard
pos = switch dashPos
    "top left" => position.top_left
    "top right" => position.top_right
    "bottom left" => position.bottom_left
    => position.bottom_right

var table t = table.new(pos, 2, 7, bgcolor=color.new(#0C1628, 0), border_color=color.new(#C8A03C, 0), border_width=1, frame_color=color.new(#C8A03C, 0), frame_width=1)
costRatio = (spreadIn > 0 and atr > 0) ? spreadIn / atr : na
if showDash and barstate.islast
    table.cell(t, 0, 0, "AT24", text_color=#E8B84A, text_size=size.large, text_halign=text.align_center)
    table.cell(t, 1, 0, "REGIME PULSE", text_color=#E8B84A, text_size=size.normal, text_halign=text.align_left)
    table.cell(t, 0, 1, "Regime", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 1, regName, text_color=regCol, text_size=size.normal, text_halign=text.align_left)
    table.cell(t, 0, 2, "Trend quality (ER)", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 2, str.tostring(er, "0.00"), text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 3, "Volatility rank", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 3, na(rank) ? "..." : str.tostring(rank, "0") + " / 100", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 4, "Spread / ATR", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 4, na(costRatio) ? "set spread input" : str.tostring(costRatio * 100, "0.0") + "%" + (costRatio > maxCost ? "  HIGH COST" : "  ok"), text_color=(not na(costRatio) and costRatio > maxCost) ? color.red : color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 5, "Session (UTC)", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 5, sess, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 6, "Context tool.", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 6, "Not a signal. algotraders24.ai", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)

// ---- alert on regime change at bar close
changed = alertOn and barstate.isconfirmed and regime != regime[1] and regime[1] != 0 and regime != 0
alertcondition(changed, "AT24 Regime change", "AT24 Regime Pulse {{ticker}} {{interval}}: regime changed")

//@version=5
// AT24 Divergence Pro - RSI divergence that cannot repaint (swing points are used only after the bars to their right have closed), and the record of how past divergences did on this chart.
// Research and planning tool. Places no orders. Not a signal. algotraders24.ai
indicator("AT24 Divergence Pro", shorttitle="AT24 DIVERG", overlay=true, max_lines_count=100, max_labels_count=50)

grp1 = "Divergence"
rsiLen = input.int(14, "RSI period", minval=2, maxval=50, group=grp1)
swK = input.int(5, "Bars on each side that confirm a swing point", minval=2, maxval=15, group=grp1)
minSep = input.int(6, "Fewest bars between the two swings", minval=2, maxval=100, group=grp1)
maxSep = input.int(60, "Most bars between the two swings", minval=5, maxval=300, group=grp1)
minDiff = input.float(2.0, "Smallest RSI difference between the two swings (points)", minval=0.0, maxval=30.0, step=0.5, group=grp1)
grp2 = "Trade plan and scorecard"
slBuf = input.float(0.25, "Stop beyond the swing extreme (ATR)", minval=0.0, maxval=3.0, step=0.05, group=grp2)
maxRisk = input.float(4.0, "Skip when the stop would be further than this (ATR)", minval=0.5, maxval=20.0, step=0.5, group=grp2)
rr = input.float(2.0, "Target as a multiple of the stop distance", minval=0.3, maxval=10.0, step=0.1, group=grp2)
maxHold = input.int(40, "Bars before a trade is closed at the market (timed exit)", minval=5, maxval=500, group=grp2)
cost = input.float(0.20, "Round-turn cost in PRICE units (TradingView has no spread data: set it for your symbol)", minval=0.0, step=0.05, group=grp2)
grp3 = "Chart"
drawN = input.int(10, "Draw the last N divergences (0 = none)", minval=0, maxval=40, group=grp3)
grp4 = "Dashboard"
showDash = input.bool(true, "Show dashboard", group=grp4)
dashPos = input.string("top right", "Position", options=["top left","top right","bottom left","bottom right"], group=grp4)

atr = ta.atr(14)
rsi = ta.rsi(close, rsiLen)
var float[] aO = array.new_float()
var float[] aH = array.new_float()
var float[] aL = array.new_float()
var float[] aC = array.new_float()
var float[] aA = array.new_float()
var float[] aR = array.new_float()
var int[] aI = array.new_int()
if barstate.isconfirmed
    array.push(aO, open)
    array.push(aH, high)
    array.push(aL, low)
    array.push(aC, close)
    array.push(aA, nz(atr))
    array.push(aR, nz(rsi, 50.0))
    array.push(aI, bar_index)

// divergences between confirmed swing points; each is known only at bar p + k
findEvents(int n, int[] eIdx, int[] eDir, int[] eP, int[] eQ) =>
    int lastLow = -1
    int lastHigh = -1
    if n > 2 * swK + 2
        for p = swK + 1 to n - 1 - swK
            bool isLow = true
            bool isHigh = true
            for j = p - swK to p - 1
                if array.get(aL, j) <= array.get(aL, p)
                    isLow := false
                if array.get(aH, j) >= array.get(aH, p)
                    isHigh := false
            for j = p + 1 to p + swK
                if array.get(aL, j) < array.get(aL, p)
                    isLow := false
                if array.get(aH, j) > array.get(aH, p)
                    isHigh := false
            if isLow
                if lastLow >= 0
                    if p - lastLow >= minSep and p - lastLow <= maxSep and array.get(aL, p) < array.get(aL, lastLow) and array.get(aR, p) > array.get(aR, lastLow) + minDiff
                        array.push(eIdx, p + swK)
                        array.push(eDir, 1)
                        array.push(eP, p)
                        array.push(eQ, lastLow)
                lastLow := p
            if isHigh
                if lastHigh >= 0
                    if p - lastHigh >= minSep and p - lastHigh <= maxSep and array.get(aH, p) > array.get(aH, lastHigh) and array.get(aR, p) < array.get(aR, lastHigh) - minDiff
                        array.push(eIdx, p + swK)
                        array.push(eDir, -1)
                        array.push(eP, p)
                        array.push(eQ, lastHigh)
                lastHigh := p
    n

runTrades(int dirF, int n, int[] eIdx, int[] eDir, int[] eP, float[] tK, float[] tD, float[] tEn, float[] tSl, float[] tTp, float[] tEx, float[] tRes, float[] tR) =>
    int lastExit = -1
    int ne = array.size(eIdx)
    if ne > 0
        for e = 0 to ne - 1
            int i = array.get(eIdx, e)
            int d = array.get(eDir, e)
            if (dirF == 0 or d == dirF) and i + 1 <= n - 1 and i > lastExit
                if array.get(aA, i) > 0.0
                    en = array.get(aO, i + 1)
                    sl = d > 0 ? array.get(aL, array.get(eP, e)) - slBuf * array.get(aA, i) : array.get(aH, array.get(eP, e)) + slBuf * array.get(aA, i)
                    risk = d * (en - sl)
                    if risk > 0.0 and risk <= maxRisk * array.get(aA, i)
                        tp = en + d * rr * risk
                        float res = 2.0
                        int ex = -1
                        float r = 0.0
                        last = math.min(n - 1, i + maxHold)
                        for j = i + 1 to last
                            slHit = d > 0 ? array.get(aL, j) <= sl : array.get(aH, j) >= sl
                            tpHit = d > 0 ? array.get(aH, j) >= tp : array.get(aL, j) <= tp
                            if slHit
                                res := -1.0
                                ex := j
                                r := -1.0 - cost / risk
                                break
                            if tpHit
                                res := 1.0
                                ex := j
                                r := rr - cost / risk
                                break
                            if j == i + maxHold
                                res := 0.0
                                ex := j
                                r := d * (array.get(aC, j) - en) / risk - cost / risk
                                break
                        array.push(tK, i)
                        array.push(tD, d)
                        array.push(tEn, en)
                        array.push(tSl, sl)
                        array.push(tTp, tp)
                        array.push(tEx, ex)
                        array.push(tRes, res)
                        array.push(tR, r)
                        lastExit := res == 2.0 ? n : ex
    ne

score(float[] res, float[] rs) =>
    int cnt = 0
    int wins = 0
    float sum = 0.0
    r2 = array.new_float()
    if array.size(res) > 0
        for i = 0 to array.size(res) - 1
            if array.get(res, i) != 2.0
                v = array.get(rs, i)
                array.push(r2, v)
                cnt += 1
                sum += v
                if v > 0
                    wins += 1
    float avg = cnt > 0 ? sum / cnt : 0.0
    float pFlip = 1.0
    if cnt >= 2
        int seed = 20261111
        int ge = 0
        flips = 4000
        for f = 1 to flips
            float s = 0.0
            for k = 0 to cnt - 1
                seed := (seed * 1103515245 + 12345) % 2147483648
                s += int(math.floor(seed / 65536.0)) % 2 == 0 ? array.get(r2, k) : -array.get(r2, k)
            if s >= sum
                ge += 1
        pFlip := (ge + 1.0) / (flips + 1.0)
    [cnt, wins, cnt > 0 ? 100.0 * wins / cnt : 0.0, avg, sum, pFlip]

verdictOf(int n, float avg, float p) =>
    n < 30 ? "too few trades (" + str.tostring(n) + " of 30)" : avg > 0 and p < 0.05 ? "POSITIVE ON THIS HISTORY (p " + str.tostring(p, "0.000") + ")" : avg < 0 and p > 0.95 ? "NEGATIVE ON THIS HISTORY" : "NO EDGE SHOWN (p " + str.tostring(p, "0.00") + ")"
verdictCol(int n, float avg, float p) =>
    n < 30 ? color.gray : avg > 0 and p < 0.05 ? color.lime : avg < 0 and p > 0.95 ? color.red : #E6B450
sg2(x) => (x >= 0 ? "+" : "") + str.tostring(x, "0.00")

pos = switch dashPos
    "top left" => position.top_left
    "top right" => position.top_right
    "bottom left" => position.bottom_left
    => position.bottom_right
var table t = table.new(pos, 2, 12, bgcolor=color.new(#0C1628, 0), border_color=color.new(#C8A03C, 0), border_width=1, frame_color=color.new(#C8A03C, 0), frame_width=1)
var line[] lns = array.new_line()
var label[] lbs = array.new_label()

if barstate.islast
    while array.size(lns) > 0
        line.delete(array.pop(lns))
    while array.size(lbs) > 0
        label.delete(array.pop(lbs))
    n = array.size(aC)
    ok = n > 500
    int[] eIdx = array.new_int()
    int[] eDir = array.new_int()
    int[] eP = array.new_int()
    int[] eQ = array.new_int()
    if ok
        findEvents(n, eIdx, eDir, eP, eQ)
    ne = array.size(eIdx)
    float[] bK = array.new_float()
    float[] bD = array.new_float()
    float[] bEn = array.new_float()
    float[] bSl = array.new_float()
    float[] bTp = array.new_float()
    float[] bEx = array.new_float()
    float[] bRes = array.new_float()
    float[] bR = array.new_float()
    float[] sK = array.new_float()
    float[] sD = array.new_float()
    float[] sEn = array.new_float()
    float[] sSl = array.new_float()
    float[] sTp = array.new_float()
    float[] sEx = array.new_float()
    float[] sRes = array.new_float()
    float[] sR = array.new_float()
    float[] xK = array.new_float()
    float[] xD = array.new_float()
    float[] xEn = array.new_float()
    float[] xSl = array.new_float()
    float[] xTp = array.new_float()
    float[] xEx = array.new_float()
    float[] xRes = array.new_float()
    float[] xR = array.new_float()
    if ok
        runTrades(1, n, eIdx, eDir, eP, bK, bD, bEn, bSl, bTp, bEx, bRes, bR)
        runTrades(-1, n, eIdx, eDir, eP, sK, sD, sEn, sSl, sTp, sEx, sRes, sR)
        runTrades(0, n, eIdx, eDir, eP, xK, xD, xEn, xSl, xTp, xEx, xRes, xR)
    [bn, bw, bh, ba, bs, bp] = score(bRes, bR)
    [sn, sw, sh, sa, ss, sp] = score(sRes, sR)
    [xn, xw, xh, xa, xs, xp] = score(xRes, xR)
    // a divergence confirmed on the last closed bar, with its plan
    int liveDir = 0
    float lvEn = 0.0
    float lvSl = 0.0
    float lvTp = 0.0
    bool lvSkip = false
    if ok and ne > 0
        if array.get(eIdx, ne - 1) == n - 1
            liveDir := array.get(eDir, ne - 1)
            lvEn := array.get(aC, n - 1)
            lvSl := liveDir > 0 ? array.get(aL, array.get(eP, ne - 1)) - slBuf * array.get(aA, n - 1) : array.get(aH, array.get(eP, ne - 1)) + slBuf * array.get(aA, n - 1)
            lvRisk = liveDir * (lvEn - lvSl)
            lvTp := lvEn + liveDir * rr * lvRisk
            lvSkip := lvRisk <= 0.0 or lvRisk > maxRisk * array.get(aA, n - 1)
    if ok and drawN > 0 and ne > 0
        int drawn = 0
        for e = ne - 1 to 0
            if drawn < drawN
                int d = array.get(eDir, e)
                int p = array.get(eP, e)
                int q = array.get(eQ, e)
                py = d > 0 ? array.get(aL, p) : array.get(aH, p)
                qy = d > 0 ? array.get(aL, q) : array.get(aH, q)
                col = d > 0 ? color.lime : color.orange
                array.push(lns, line.new(array.get(aI, q), qy, array.get(aI, p), py, color=col, width=2))
                array.push(lbs, label.new(array.get(aI, p), py, d > 0 ? "bull" : "bear", style=d > 0 ? label.style_label_up : label.style_label_down, color=color.new(col, 30), textcolor=color.black, size=size.tiny))
                drawn += 1
    if showDash
        table.cell(t, 0, 0, "AT24", text_color=#E8B84A, text_size=size.large)
        table.cell(t, 1, 0, "DIVERGENCE PRO", text_color=#E8B84A, text_size=size.normal, text_halign=text.align_left)
        if not ok
            table.cell(t, 0, 1, "State", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 1, "LOADING HISTORY (NEED 500+ BARS)", text_color=color.gray, text_size=size.normal, text_halign=text.align_left)
        else
            table.cell(t, 0, 1, "Now", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 1, liveDir == 0 ? "NO DIVERGENCE ON THE LAST CLOSED BAR  -  " + syminfo.ticker + ", RSI " + str.tostring(rsiLen) + ", " + str.tostring(ne) + " divergences found" : (liveDir > 0 ? "BULLISH" : "BEARISH") + " DIVERGENCE CONFIRMED ON THE LAST CLOSED BAR" + (lvSkip ? "  -  no plan (stop too far)" : "  -  entry ~" + str.tostring(lvEn, format.mintick) + "  stop " + str.tostring(lvSl, format.mintick) + "  target " + str.tostring(lvTp, format.mintick)), text_color=liveDir == 0 ? color.gray : liveDir > 0 ? color.lime : color.orange, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 2, "Scorecard", text_color=#E8B84A, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 2, "past divergences on this chart's own history, one trade at a time (" + str.tostring(n) + " bars, cost " + str.tostring(cost, "0.00") + ")", text_color=#E8B84A, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 3, "Bullish", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 3, str.tostring(bn) + " trades   hit " + str.tostring(bh, "0") + "%   average " + sg2(ba) + " R after cost   total " + sg2(bs) + " R", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 4, "", text_size=size.tiny)
            table.cell(t, 1, 4, verdictOf(bn, ba, bp), text_color=verdictCol(bn, ba, bp), text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 5, "Bearish", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 5, str.tostring(sn) + " trades   hit " + str.tostring(sh, "0") + "%   average " + sg2(sa) + " R after cost   total " + sg2(ss) + " R", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 6, "", text_size=size.tiny)
            table.cell(t, 1, 6, verdictOf(sn, sa, sp), text_color=verdictCol(sn, sa, sp), text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 7, "All", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 7, str.tostring(xn) + " trades   hit " + str.tostring(xh, "0") + "%   average " + sg2(xa) + " R after cost   total " + sg2(xs) + " R", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 8, "", text_size=size.tiny)
            table.cell(t, 1, 8, verdictOf(xn, xa, xp), text_color=verdictCol(xn, xa, xp), text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 9, "Read it", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 9, "A swing point counts only after the bars to its right have closed (no repainting); the signal comes with that delay. No edge shown = no better than luck here.", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 10, "Note", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 10, "Past results on this chart do not predict future results. A TradingView chart holds fewer bars than a broker terminal, so counts are smaller.", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 11, "Research tool.", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, 11, "Not a signal. algotraders24.ai", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)

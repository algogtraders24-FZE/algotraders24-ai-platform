//@version=5
// AT24 Persistence Meter - variance ratio of price moves: do moves tend to continue, reverse, or look like a random walk?
// Context tool. Not a signal. algotraders24.ai
indicator("AT24 Persistence Meter", shorttitle="AT24 PERSIST")

grp1 = "Test"
W = input.int(400, "Bars in the test window", minval=100, maxval=2000, group=grp1)
Q = input.int(8, "Main move length q (bars) for the state", minval=2, maxval=40, group=grp1)
Hz = input.int(32, "Bars: previous move / next move for the study", minval=4, maxval=200, group=grp1)
zc = input.float(1.645, "z threshold (1.645 = one-sided 5 %)", minval=0.5, maxval=4.0, step=0.05, group=grp1)
grp3 = "Dashboard"
showDash = input.bool(true, "Show dashboard", group=grp3)
dashPos = input.string("top right", "Position", options=["top left","top right","bottom left","bottom right"], group=grp3)

var float[] rets = array.new_float()
var float[] cl = array.new_float()
if barstate.isconfirmed
    array.push(rets, array.size(cl) == 0 ? 0.0 : math.log(close / array.get(cl, array.size(cl) - 1)))
    array.push(cl, close)

// variance ratio of the log returns r[end-W+1 .. end] for horizon q: [ok, vr, z]
vrFn(float[] r, int endI, int win, int q) =>
    bool ok = false
    float vr = 1.0
    float z = 0.0
    if q >= 2 and win >= q * 4 and endI - win + 1 >= 0
        a = endI - win + 1
        float mu = 0.0
        for i = a to endI
            mu += array.get(r, i)
        mu := mu / win
        float s1 = 0.0
        for i = a to endI
            d = array.get(r, i) - mu
            s1 += d * d
        va = s1 / (win - 1)
        m = q * (win - q + 1) * (1.0 - q / win)
        float sq = 0.0
        for k = a + q - 1 to endI
            float s = 0.0
            for j = 0 to q - 1
                s += array.get(r, k - j)
            s -= q * mu
            sq += s * s
        if va > 0.0
            vr := (sq / m) / va
            phi = 2.0 * (2.0 * q - 1.0) * (q - 1.0) / (3.0 * q * win)
            z := (vr - 1.0) / math.sqrt(phi)
            ok := true
    [ok, vr, z]

hurst(vr, q) => vr > 0.0 and q >= 2 ? 0.5 + math.log(vr) / (2.0 * math.log(q)) : 0.5
ci(pctv, n) => n < 1 ? "-" : str.tostring(pctv, "0") + "% (n=" + str.tostring(n) + ", +-" + str.tostring(1.96 * math.sqrt(math.max(pctv * (100.0 - pctv), 0.0) / n), "0") + ")"
sg2(x) => (x >= 0 ? "+" : "") + str.tostring(x, "0.00")

pos = switch dashPos
    "top left" => position.top_left
    "top right" => position.top_right
    "bottom left" => position.bottom_left
    => position.bottom_right
var table t = table.new(pos, 2, 12, bgcolor=color.new(#0C1628, 0), border_color=color.new(#C8A03C, 0), border_width=1, frame_color=color.new(#C8A03C, 0), frame_width=1)

var float zLast = na
hline(zc, "+z threshold", color=color.new(color.lime, 60), linestyle=hline.style_dashed)
hline(-zc, "-z threshold", color=color.new(color.orange, 60), linestyle=hline.style_dashed)
hline(0, "0", color=color.new(color.gray, 70))

if barstate.islast
    n = array.size(rets)
    q0 = Q == 4 ? 2 : 4
    q1 = Q == 4 ? 4 : Q
    q2 = Q * 2
    [ok0, vr0, z0] = vrFn(rets, n - 1, W, q0)
    [ok1, vr1, z1] = vrFn(rets, n - 1, W, q1)
    [ok2, vr2, z2] = vrFn(rets, n - 1, W, q2)
    zLast := ok1 ? z1 : na
    int state = z1 >= zc ? 1 : z1 <= -zc ? 2 : 3
    int[] cnt = array.new_int(4, 0)
    int[] same = array.new_int(4, 0)
    if ok1 and n - Hz - 1 >= W + Hz
        for tt = W + Hz to n - Hz - 1 by Hz
            [okS, vrS, zS] = vrFn(rets, tt, W, q1)
            if okS
                cT = array.get(cl, tt)
                prev = math.log(cT / array.get(cl, tt - Hz))
                nxt = math.log(array.get(cl, tt + Hz) / cT)
                if prev != 0.0 and nxt != 0.0
                    isSame = (prev > 0.0) == (nxt > 0.0)
                    g = zS >= zc ? 1 : zS <= -zc ? 2 : 3
                    array.set(cnt, 0, array.get(cnt, 0) + 1)
                    if isSame
                        array.set(same, 0, array.get(same, 0) + 1)
                    array.set(cnt, g, array.get(cnt, g) + 1)
                    if isSame
                        array.set(same, g, array.get(same, g) + 1)
    n0 = array.get(cnt, 0)
    nt = array.get(cnt, 1)
    nm = array.get(cnt, 2)
    nr = array.get(cnt, 3)
    pAll = n0 > 0 ? 100.0 * array.get(same, 0) / n0 : 0.0
    pT = nt > 0 ? 100.0 * array.get(same, 1) / nt : 0.0
    pM = nm > 0 ? 100.0 * array.get(same, 2) / nm : 0.0
    stTxt = state == 1 ? "MOVES TEND TO CONTINUE" : state == 2 ? "MOVES TEND TO REVERSE" : "LOOKS LIKE A RANDOM WALK"
    stCol = state == 1 ? color.lime : state == 2 ? #E6B450 : color.gray
    if showDash
        table.cell(t, 0, 0, "AT24", text_color=#E8B84A, text_size=size.large)
        table.cell(t, 1, 0, "PERSISTENCE METER", text_color=#E8B84A, text_size=size.normal, text_halign=text.align_left)
        if not ok1
            table.cell(t, 0, 1, "State", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 1, "NOT ENOUGH HISTORY", text_color=color.gray, text_size=size.normal, text_halign=text.align_left)
        else
            table.cell(t, 0, 1, "State", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 1, stTxt, text_color=stCol, text_size=size.normal, text_halign=text.align_left)
            table.cell(t, 0, 2, str.tostring(q0) + "-bar", text_color=color.silver, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 2, "VR " + str.tostring(vr0, "0.00") + "   z " + sg2(z0) + "   exponent " + str.tostring(hurst(vr0, q0), "0.00"), text_color=color.silver, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 3, str.tostring(q1) + "-bar", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 3, "VR " + str.tostring(vr1, "0.00") + "   z " + sg2(z1) + "   exponent " + str.tostring(hurst(vr1, q1), "0.00") + "   <- state", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 4, str.tostring(q2) + "-bar", text_color=color.silver, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 4, "VR " + str.tostring(vr2, "0.00") + "   z " + sg2(z2) + "   exponent " + str.tostring(hurst(vr2, q2), "0.00"), text_color=color.silver, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 5, "Study", text_color=#E8B84A, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 5, str.tostring(n0) + " windows of " + str.tostring(Hz) + " bars (q=" + str.tostring(q1) + ")", text_color=#E8B84A, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 6, "Time spent", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 6, "trending " + str.tostring(n0 > 0 ? 100.0 * nt / n0 : 0.0, "0") + "%  reverting " + str.tostring(n0 > 0 ? 100.0 * nm / n0 : 0.0, "0") + "%  random " + str.tostring(n0 > 0 ? 100.0 * nr / n0 : 0.0, "0") + "%", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 7, "Next move", text_color=#E8B84A, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 7, "went the SAME way as the last move:", text_color=#E8B84A, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 8, "Any time", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 8, ci(pAll, n0), text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 9, "Trending", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 9, ci(pT, nt), text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 10, "Reverting", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 10, ci(pM, nm), text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 11, "Descriptive history.", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, 11, "Small samples: a gap from 'any time' inside +- is noise. Not a signal. algotraders24.ai", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)

plot(barstate.islast ? zLast : na, "z (main q)", color=zLast >= zc ? color.lime : zLast <= -zc ? color.orange : color.gray, style=plot.style_circles, linewidth=4)

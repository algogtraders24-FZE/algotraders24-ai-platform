//@version=5
// AT24 History Doctor - audits the hourly history loaded on the chart: first real hourly day, bars per year, broken bars, missing hours.
// Data audit only. Not a signal. algotraders24.ai
indicator("AT24 History Doctor", shorttitle="AT24 HIST", overlay=true)

grp3 = "Dashboard"
showDash = input.bool(true, "Show dashboard", group=grp3)
dashPos = input.string("top right", "Position", options=["top left","top right","bottom left","bottom right"], group=grp3)

var int[] aT = array.new_int()
var float[] aO = array.new_float()
var float[] aH = array.new_float()
var float[] aL = array.new_float()
var float[] aC = array.new_float()
if barstate.isconfirmed
    array.push(aT, time)
    array.push(aO, open)
    array.push(aH, high)
    array.push(aL, low)
    array.push(aC, close)

pos = switch dashPos
    "top left" => position.top_left
    "top right" => position.top_right
    "bottom left" => position.bottom_left
    => position.bottom_right
var table t = table.new(pos, 2, 16, bgcolor=color.new(#0C1628, 0), border_color=color.new(#C8A03C, 0), border_width=1, frame_color=color.new(#C8A03C, 0), frame_width=1)

if barstate.islast
    n = array.size(aT)
    ok = timeframe.period == "60" and n > 500
    int invalid = 0
    int nonMono = 0
    int validFrom = -1
    int gapCount = 0
    int gapHours = 0
    int[] yrs = array.new_int()
    int[] yBars = array.new_int()
    int[] yDays = array.new_int()
    int[] yFull = array.new_int()
    if ok
        for i = 0 to n - 1
            tm = array.get(aT, i)
            o = array.get(aO, i)
            h = array.get(aH, i)
            l = array.get(aL, i)
            c = array.get(aC, i)
            if h < l or o > h or o < l or c > h or c < l or o <= 0 or c <= 0
                invalid += 1
            if i > 0 and tm <= array.get(aT, math.max(i - 1, 0))
                nonMono += 1
        // per day: bars, first day with 20+ hourly bars
        int i = 0
        while i < n
            dk = int(math.floor(array.get(aT, i) / 86400000.0))
            int j = i
            for q = i to n - 1
                if int(math.floor(array.get(aT, q) / 86400000.0)) != dk
                    break
                j := q + 1
            y = year(array.get(aT, i), "UTC")
            int yi = array.indexof(yrs, y)
            if yi < 0
                array.push(yrs, y)
                array.push(yBars, 0)
                array.push(yDays, 0)
                array.push(yFull, 0)
                yi := array.size(yrs) - 1
            array.set(yBars, yi, array.get(yBars, yi) + (j - i))
            array.set(yDays, yi, array.get(yDays, yi) + 1)
            if j - i >= 20
                array.set(yFull, yi, array.get(yFull, yi) + 1)
                if validFrom < 0
                    validFrom := i
            i := j
        if validFrom >= 0 and n > validFrom + 1
            for k = validFrom + 1 to n - 1
                gap = array.get(aT, k) - array.get(aT, k - 1)
                if gap > 2 * 3600000 and gap < 44 * 3600000
                    gapCount += 1
                    gapHours += int(gap / 3600000) - 1
    sparse = validFrom > 30
    broken = invalid > 0 or nonMono > 0
    verdict = validFrom < 0 ? "NO HOURLY HISTORY" : broken ? "BROKEN BARS FOUND" : sparse ? "PARTLY USABLE" : "CLEAN"
    vcol = validFrom < 0 or broken ? color.red : sparse ? #E6B450 : color.lime
    if showDash
        table.cell(t, 0, 0, "AT24", text_color=#E8B84A, text_size=size.large)
        table.cell(t, 1, 0, "HISTORY DOCTOR", text_color=#E8B84A, text_size=size.normal, text_halign=text.align_left)
        if not ok
            table.cell(t, 0, 1, "State", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 1, "USE THE 1H CHART (NEED 500+ BARS)", text_color=color.gray, text_size=size.normal, text_halign=text.align_left)
        else
            table.cell(t, 0, 1, "Verdict", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 1, verdict + "  -  " + syminfo.ticker, text_color=vcol, text_size=size.normal, text_halign=text.align_left)
            table.cell(t, 0, 2, "Hourly from", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 2, validFrom < 0 ? "no day with 20+ hourly bars" : "hourly data usable from " + str.format_time(array.get(aT, validFrom), "yyyy-MM-dd"), text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 3, "Spread", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 3, "not available on TradingView (use the MetaTrader edition for spread coverage)", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 4, "Year", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 4, "bars   hourly days (of days seen)", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            int ny = array.size(yrs)
            int rows = 0
            for k = math.max(0, ny - 6) to ny - 1
                days = array.get(yDays, k)
                fd = days > 0 ? 1.0 * array.get(yFull, k) / days : 0.0
                rcol = fd < 0.5 ? color.red : fd < 0.9 ? #E6B450 : color.lime
                table.cell(t, 0, 5 + rows, str.tostring(array.get(yrs, k)), text_color=rcol, text_size=size.small, text_halign=text.align_left)
                table.cell(t, 1, 5 + rows, str.tostring(array.get(yBars, k)) + "   " + str.tostring(array.get(yFull, k)) + " / " + str.tostring(days), text_color=rcol, text_size=size.small, text_halign=text.align_left)
                rows += 1
            table.cell(t, 0, 11, "Errors", text_color=(invalid + nonMono) > 0 ? color.red : color.silver, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 11, "broken bars " + str.tostring(invalid) + "   order errors " + str.tostring(nonMono) + "   missing hours " + str.tostring(gapHours) + " (" + str.tostring(gapCount) + " breaks)", text_color=(invalid + nonMono) > 0 ? color.red : color.silver, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 12, "Read it", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 12, "Do not trust hour-of-day statistics before the 'hourly from' date.", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 13, "Checked", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 13, str.tostring(n) + " hourly bars loaded on this chart", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 14, "Data audit.", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, 14, "Not a signal. algotraders24.ai", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)

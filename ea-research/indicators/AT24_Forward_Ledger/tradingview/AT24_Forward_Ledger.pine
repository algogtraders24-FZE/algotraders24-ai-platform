//@version=5
// AT24 Forward Ledger - research candidate rules registered WITH A DATE; only what happens after the date counts (out-of-sample by construction).
// Research ledger, not a signal. Places no trades. algotraders24.ai
indicator("AT24 Forward Ledger", shorttitle="AT24 LEDGER", overlay=true)

grp1 = "Ledger"
replayFrom = input.time(0, "0 = official ledger. A date = REPLAY from that date (in-sample, NOT evidence)", group=grp1)
minTrades = input.int(30, "Trades needed before a verdict is shown", minval=10, maxval=500, group=grp1)
grp3 = "Dashboard"
showDash = input.bool(true, "Show dashboard", group=grp3)
dashPos = input.string("top right", "Position", options=["top left","top right","bottom left","bottom right"], group=grp3)

// registration dates (UTC) - rules are only added with later dates and never edited
reg0 = timestamp("GMT", 2026, 11, 10, 0, 0)
reg1 = timestamp("GMT", 2026, 11, 10, 0, 0)
reg2 = timestamp("GMT", 2026, 11, 10, 0, 0)
reg3 = timestamp("GMT", 2026, 11, 11, 0, 0)

var int[] aT = array.new_int()
var float[] aO = array.new_float()
var float[] aH = array.new_float()
var float[] aL = array.new_float()
var float[] aC = array.new_float()
var int[] aNy = array.new_int()
var int[] aGh = array.new_int()
var int[] aGd = array.new_int()
atrNow = ta.atr(14)
var float[] aA = array.new_float()
if barstate.isconfirmed
    array.push(aT, time)
    array.push(aO, open)
    array.push(aH, high)
    array.push(aL, low)
    array.push(aC, close)
    array.push(aNy, hour(time, "America/New_York"))
    array.push(aGh, hour(time, "GMT"))
    array.push(aGd, int(math.floor(time / 86400000.0)))
    array.push(aA, nz(atrNow))

sg1(x) => (x >= 0 ? "+" : "") + str.tostring(x, "0.0")
sg2(x) => (x >= 0 ? "+" : "") + str.tostring(x, "0.00")

// returns [n, meanBp, t, hitPct, cumBp, adjMeanBp, tAdj]
finish(int cnt, float sum, float sum2, float sumDir, float sumHoldDir, int hit, float driftBp) =>
    float mean = 0.0
    float tadj = 0.0
    float adj = 0.0
    float hitP = 0.0
    if cnt > 0
        mean := sum / cnt
        hitP := 100.0 * hit / cnt
        if cnt > 1
            v = (sum2 - cnt * mean * mean) / (cnt - 1)
            sd = math.sqrt(math.max(v, 0.0))
            if sd > 0.0
                adj := mean - (sumHoldDir / cnt) * driftBp
                tadj := adj / (sd / math.sqrt(cnt))
    [cnt, mean, hitP, sum, adj, tadj]

pos = switch dashPos
    "top left" => position.top_left
    "top right" => position.top_right
    "bottom left" => position.bottom_left
    => position.bottom_right
var table t = table.new(pos, 2, 18, bgcolor=color.new(#0C1628, 0), border_color=color.new(#C8A03C, 0), border_width=1, frame_color=color.new(#C8A03C, 0), frame_width=1)

if barstate.islast
    n = array.size(aT)
    ok = timeframe.period == "60" and n > 300
    names = array.from("R1  Long the New York 18:00 hour", "R2  Fade an H1 bar of 2.5+ ATR (4 h)", "R3  Follow 1h/4h/24h/120h agreement (24 h)", "R4  Asia follows the last New York session")
    regs = array.from(reg0, reg1, reg2, reg3)
    int[] rN = array.new_int(4, 0)
    float[] rMean = array.new_float(4, 0.0)
    float[] rHit = array.new_float(4, 0.0)
    float[] rCum = array.new_float(4, 0.0)
    float[] rAdj = array.new_float(4, 0.0)
    float[] rT = array.new_float(4, 0.0)
    if ok
        for r = 0 to 3
            int start = replayFrom > 0 ? replayFrom : array.get(regs, r)
            float ds = 0.0
            int dn = 0
            for i = 0 to n - 1
                if array.get(aT, i) >= start
                    ds += math.log(array.get(aC, i) / array.get(aO, i))
                    dn += 1
            driftBp = dn > 0 ? 10000.0 * ds / dn : 0.0
            float sum = 0.0
            float sum2 = 0.0
            float sumDir = 0.0
            float sumHoldDir = 0.0
            int cnt = 0
            int hit = 0
            if r < 3
                float hold = r == 0 ? 1.0 : r == 1 ? 4.0 : 24.0
                int lastExit = -1
                for i = 15 to n - 1
                    int entry = -1
                    int exitBar = -1
                    int dir = 0
                    if r == 0
                        if array.get(aNy, i) == 18 and array.get(aT, i) >= start
                            entry := i
                            exitBar := i
                            dir := 1
                    else if r == 1
                        body = array.get(aC, i) - array.get(aO, i)
                        a1 = array.get(aA, i - 1)
                        if a1 > 0.0 and math.abs(body) >= 2.5 * a1 and i + 4 < n
                            if array.get(aT, i + 1) >= start
                                entry := i + 1
                                exitBar := i + 4
                                dir := body > 0.0 ? -1 : 1
                    else
                        if i >= 120 and i + 24 < n
                            c0 = array.get(aC, i)
                            int s = 0
                            s += c0 > array.get(aC, i - 1) ? 1 : -1
                            s += c0 > array.get(aC, i - 4) ? 1 : -1
                            s += c0 > array.get(aC, i - 24) ? 1 : -1
                            s += c0 > array.get(aC, i - 120) ? 1 : -1
                            if math.abs(s) == 4 and array.get(aT, i + 1) >= start
                                entry := i + 1
                                exitBar := i + 24
                                dir := s > 0 ? 1 : -1
                    if entry >= 0 and exitBar < n and entry > lastExit
                        rr = 10000.0 * dir * math.log(array.get(aC, exitBar) / array.get(aO, entry))
                        lastExit := exitBar
                        cnt += 1
                        sum += rr
                        sum2 += rr * rr
                        sumDir += dir
                        sumHoldDir += dir * hold
                        if rr > 0.0
                            hit += 1
            else
                // relay: sign of the previous day's New York session (GMT 13-21, 6+ bars) -> trade the next day's Asian session (GMT hour < 7, 6+ bars) with it
                float prevNy = 0.0
                int prevNyBars = 0
                bool havePrev = false
                int i = 0
                while i < n
                    dk = array.get(aGd, i)
                    int j = i
                    for q = i to n - 1
                        if array.get(aGd, q) != dk
                            break
                        j := q + 1
                    int a0 = -1
                    int a1b = -1
                    int ac = 0
                    for k = i to j - 1
                        if array.get(aGh, k) < 7
                            if a0 < 0
                                a0 := k
                            a1b := k
                            ac += 1
                    if havePrev and prevNyBars >= 6 and prevNy != 0.0 and a0 == i and ac >= 6
                        if array.get(aGh, a0) <= 1 and array.get(aT, a0) >= start
                            int dir2 = prevNy > 0.0 ? 1 : -1
                            rr = 10000.0 * dir2 * math.log(array.get(aC, a1b) / array.get(aO, a0))
                            hold2 = a1b - a0 + 1
                            cnt += 1
                            sum += rr
                            sum2 += rr * rr
                            sumDir += dir2
                            sumHoldDir += dir2 * hold2
                            if rr > 0.0
                                hit += 1
                    float ny = 0.0
                    int nb = 0
                    for k = i to j - 1
                        gk = array.get(aGh, k)
                        if gk >= 13 and gk < 21
                            ny += math.log(array.get(aC, k) / array.get(aO, k))
                            nb += 1
                    prevNy := ny
                    prevNyBars := nb
                    havePrev := true
                    i := j
            [fn, fm, fh, fc, fa, ft] = finish(cnt, sum, sum2, sumDir, sumHoldDir, hit, driftBp)
            array.set(rN, r, fn)
            array.set(rMean, r, fm)
            array.set(rHit, r, fh)
            array.set(rCum, r, fc)
            array.set(rAdj, r, fa)
            array.set(rT, r, ft)
    thrT = 2.5
    replay = replayFrom > 0
    if showDash
        table.cell(t, 0, 0, "AT24", text_color=#E8B84A, text_size=size.large)
        table.cell(t, 1, 0, "FORWARD LEDGER", text_color=#E8B84A, text_size=size.normal, text_halign=text.align_left)
        if not ok
            table.cell(t, 0, 1, "State", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 1, "USE THE 1H CHART (NEED 300+ BARS)", text_color=color.gray, text_size=size.normal, text_halign=text.align_left)
        else
            daysOpen = (array.get(aT, n - 1) - reg0) / 86400000.0
            hdr = replay ? "REPLAY - IN-SAMPLE, NOT EVIDENCE" : daysOpen < 0 ? "LEDGER OPENS 2026-11-10" : "LEDGER OPEN: DAY " + str.tostring(int(math.floor(daysOpen)) + 1)
            table.cell(t, 0, 1, "Ledger", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 1, hdr, text_color=replay ? #E6B450 : color.white, text_size=size.normal, text_halign=text.align_left)
            for r = 0 to 3
                nn = array.get(rN, r)
                v = nn < minTrades ? "COLLECTING " + str.tostring(nn) + " of " + str.tostring(minTrades) + " trades" : math.abs(array.get(rT, r)) >= thrT ? (array.get(rAdj, r) > 0 ? "POSITIVE SO FAR" : "NEGATIVE SO FAR") + "  (t " + sg2(array.get(rT, r)) + ", beats chance after correction)" : "NO EDGE SO FAR  (t " + sg2(array.get(rT, r)) + ", hit " + str.tostring(array.get(rHit, r), "0") + "%, sum " + sg1(array.get(rCum, r)) + " bp)"
                vc = nn < minTrades ? color.gray : math.abs(array.get(rT, r)) >= thrT ? (array.get(rAdj, r) > 0 ? color.lime : color.red) : color.silver
                table.cell(t, 0, 2 + r * 3, str.substring(array.get(names, r), 0, 2), text_color=#E8B84A, text_size=size.small, text_halign=text.align_left)
                table.cell(t, 1, 2 + r * 3, array.get(names, r) + "   from " + str.format_time(replay ? replayFrom : array.get(regs, r), "yyyy-MM-dd", "GMT"), text_color=#E8B84A, text_size=size.small, text_halign=text.align_left)
                table.cell(t, 0, 3 + r * 3, "", text_size=size.tiny)
                table.cell(t, 1, 3 + r * 3, "trades " + str.tostring(nn) + "  mean " + sg1(array.get(rMean, r)) + " bp  net of drift " + sg1(array.get(rAdj, r)), text_color=color.white, text_size=size.small, text_halign=text.align_left)
                table.cell(t, 0, 4 + r * 3, "", text_size=size.tiny)
                table.cell(t, 1, 4 + r * 3, v, text_color=vc, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 14, "Note", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 14, "Rules are only added with later dates, never edited. Verdict needs |t| >= 2.5 (0.05 / 4 rules).", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 15, "Ledger.", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, 15, "Research ledger, not a signal. Replays closed bars, places no trades. Past results do not predict. algotraders24.ai", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)

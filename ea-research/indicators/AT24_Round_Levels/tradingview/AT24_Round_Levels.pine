//@version=5
// AT24 Round Levels - round-number grid + nearest levels, and a real test: does price react at round
// numbers more than at CONTROL levels half a step away? Context tool. Not a signal. algotraders24.ai
// Defaults suit Gold (10 / 50 / 100). Set the steps for other symbols.
indicator("AT24 Round Levels", shorttitle="AT24 RN", overlay=true, max_lines_count=60, max_labels_count=20)

grp1 = "Levels (price units)"
step1 = input.float(10.0, "Fine step", minval=0.0001, group=grp1)
step2 = input.float(50.0, "Middle step", minval=0.0001, group=grp1)
step3 = input.float(100.0, "Big step", minval=0.0001, group=grp1)
lines1 = input.int(6, "Fine lines each side of price", minval=0, maxval=10, group=grp1)
lines2 = input.int(4, "Middle lines each side", minval=0, maxval=10, group=grp1)
lines3 = input.int(3, "Big lines each side", minval=0, maxval=10, group=grp1)
grp2 = "Statistics"
windowBars = input.int(20, "Bars to decide bounce or break after a touch", minval=3, group=grp2)
reactAtr = input.float(1.0, "Reaction size in ATR", minval=0.1, step=0.1, group=grp2)
atrLen = input.int(14, "ATR length", minval=1, group=grp2)
grp3 = "Look"
col1 = input.color(color.gray, "Fine lines", group=grp3)
col2 = input.color(color.aqua, "Middle lines", group=grp3)
col3 = input.color(color.yellow, "Big lines", group=grp3)
showDash = input.bool(true, "Show dashboard", group=grp3)
dashPos = input.string("top right", "Position", options=["top left","top right","bottom left","bottom right"], group=grp3)

atr = ta.atr(atrLen)

// groups: 0..2 = real levels (step1..3), 3..5 = control levels half a step away
var float[] cnt = array.new_float(24, 0.0)      // per group: events, bounce, break, neither
var float[] pLv = array.new_float()
var int[] pDir = array.new_int()
var float[] pR = array.new_float()
var int[] pStart = array.new_int()
var int[] pGrp = array.new_int()

stepOf(g) => g % 3 == 0 ? step1 : g % 3 == 1 ? step2 : step3

// resolve pending touches with the current bar (touches are added after this, so resolution starts on the NEXT bar)
if array.size(pLv) > 0
    for k = array.size(pLv) - 1 to 0
        lv = array.get(pLv, k)
        d = array.get(pDir, k)
        r = array.get(pR, k)
        g = array.get(pGrp, k)
        bnc = d == 1 ? high >= lv + r : low <= lv - r
        brk = d == 1 ? low <= lv - r : high >= lv + r
        res = -1
        if bnc and brk
            res := 3
        else if bnc
            res := 1
        else if brk
            res := 2
        else if bar_index - array.get(pStart, k) >= windowBars
            res := 3
        if res != -1
            array.set(cnt, g * 4, array.get(cnt, g * 4) + 1)
            idx = res == 1 ? 1 : res == 2 ? 2 : 3
            array.set(cnt, g * 4 + idx, array.get(cnt, g * 4 + idx) + 1)
            array.remove(pLv, k)
            array.remove(pDir, k)
            array.remove(pR, k)
            array.remove(pStart, k)
            array.remove(pGrp, k)

// detect new touches on this bar
if bar_index > atrLen and atr > 0
    for g = 0 to 5
        st = stepOf(g)
        off = g >= 3 ? 0.5 : 0.0
        kmin = math.ceil(low / st - off)
        kmax = math.floor(high / st - off)
        if kmax - kmin < 8
            for kk = kmin to kmax
                lv = (kk + off) * st
                if not (low[1] <= lv and lv <= high[1]) and math.abs(close[1] - lv) >= 0.25 * atr
                    array.push(pLv, lv)
                    array.push(pDir, close[1] > lv ? 1 : -1)
                    array.push(pR, reactAtr * atr)
                    array.push(pStart, bar_index)
                    array.push(pGrp, g)

// ---- grid lines (redrawn on the last bar)
var line[] gl = array.new_line()
var label[] gb = array.new_label()
drawGrid(st, lines, c, w) =>
    base = math.floor(close / st) * st
    if lines > 0
        for k = -lines + 1 to lines
            lv = base + k * st
            array.push(gl, line.new(bar_index - 1, lv, bar_index, lv, extend=extend.both, color=c, width=w, style=line.style_dotted))
    0

if barstate.islast
    if array.size(gl) > 0
        for i = 0 to array.size(gl) - 1
            line.delete(array.get(gl, i))
    array.clear(gl)
    drawGrid(step1, lines1, col1, 1)
    drawGrid(step2, lines2, col2, 1)
    drawGrid(step3, lines3, col3, 2)

stat(g, k) => array.get(cnt, g * 4 + k)
pct(x, y) => y > 0 ? 100.0 * x / y : 0.0
line1(i, st) =>
    ev = stat(i, 0)
    evc = stat(i + 3, 0)
    str.tostring(st, "#.##") + "  n=" + str.tostring(ev, "0") + "  bounce " + str.tostring(pct(stat(i, 1), ev), "0") + "% (ctrl " + str.tostring(pct(stat(i + 3, 1), evc), "0") + "%)  break " + str.tostring(pct(stat(i, 2), ev), "0") + "% (ctrl " + str.tostring(pct(stat(i + 3, 2), evc), "0") + "%)"

pos = switch dashPos
    "top left" => position.top_left
    "top right" => position.top_right
    "bottom left" => position.bottom_left
    => position.bottom_right
var table t = table.new(pos, 2, 8, bgcolor=color.new(#0C1628, 0), border_color=color.new(#C8A03C, 0), border_width=1, frame_color=color.new(#C8A03C, 0), frame_width=1)
if showDash and barstate.islast
    table.cell(t, 0, 0, "AT24", text_color=#E8B84A, text_size=size.large)
    table.cell(t, 1, 0, "ROUND LEVELS", text_color=#E8B84A, text_size=size.normal, text_halign=text.align_left)
    nb3 = math.floor(close / step3) * step3
    na3 = math.ceil(close / step3) * step3
    nearest = (close - nb3 <= na3 - close) ? nb3 : na3
    table.cell(t, 0, 1, "Nearest big level", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 1, str.tostring(nearest, format.mintick) + "  (" + str.tostring(close - nearest, "+0.00;-0.00") + ")", text_color=col3, text_size=size.normal, text_halign=text.align_left)
    table.cell(t, 0, 2, "Step", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 2, "Touches, bounce / break (real vs control)", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 3, "Fine", text_color=col1, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 3, line1(0, step1), text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 4, "Middle", text_color=col2, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 4, line1(1, step2), text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 5, "Big", text_color=col3, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 5, line1(2, step3), text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 6, "Control levels sit half a step away. Equal numbers = no round-number effect.", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.merge_cells(t, 0, 6, 1, 6)
    table.cell(t, 0, 7, "Descriptive history. Not a signal. algotraders24.ai", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.merge_cells(t, 0, 7, 1, 7)

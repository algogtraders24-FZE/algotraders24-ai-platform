//@version=5
// AT24 Liquidity Levels - previous day / week / month high and low, marked untouched / swept / accepted,
// plus what really happened after sweeps on this symbol. Context tool. Not a signal. algotraders24.ai
indicator("AT24 Liquidity Levels", shorttitle="AT24 LV", overlay=true, max_lines_count=60, max_labels_count=60)

grp1 = "Levels"
showW = input.bool(true, "Show previous week high/low", group=grp1)
showM = input.bool(true, "Show previous month high/low", group=grp1)
statDays = input.int(60, "Days used for the sweep statistics", minval=5, maxval=250, group=grp1)
dayCol = input.color(color.yellow, "Day levels", group=grp1)
weekCol = input.color(color.aqua, "Week levels", group=grp1)
monthCol = input.color(color.fuchsia, "Month levels", group=grp1)
grp3 = "Dashboard"
showDash = input.bool(true, "Show dashboard", group=grp3)
dashPos = input.string("top right", "Position", options=["top left","top right","bottom left","bottom right"], group=grp3)

// previous period levels (non-repainting: previous completed bar of the higher timeframe)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)
// current period so far (to know if a level was swept / accepted)
[dh, dl, dc] = request.security(syminfo.tickerid, "D", [high, low, close])
[wh, wl, wc] = request.security(syminfo.tickerid, "W", [high, low, close])
[mh, ml, mc] = request.security(syminfo.tickerid, "M", [high, low, close])
dStart = time("D")
wStart = time("W")
mStart = time("M")

stHi(lvl, h, c) => na(lvl) ? 0 : h > lvl ? (c > lvl ? 2 : 1) : 0
stLo(lvl, l, c) => na(lvl) ? 0 : l < lvl ? (c < lvl ? 2 : 1) : 0

// ---- day statistics: finalise the previous day when a new day starts
newDay = ta.change(dStart) != 0
var float curPdh = na
var float curPdl = na
var bool swHi = false
var bool swLo = false
var float dayClose = na
var int[] oHiA = array.new_int()
var int[] oLoA = array.new_int()
var bool[] sHiA = array.new_bool()
var bool[] sLoA = array.new_bool()
if newDay
    if not na(curPdh) and not na(dayClose)
        array.push(sHiA, swHi)
        array.push(sLoA, swLo)
        array.push(oHiA, swHi ? (dayClose <= curPdh ? 1 : 2) : 0)
        array.push(oLoA, swLo ? (dayClose >= curPdl ? 1 : 2) : 0)
        if array.size(oHiA) > statDays
            array.shift(oHiA)
            array.shift(oLoA)
            array.shift(sHiA)
            array.shift(sLoA)
    swHi := false
    swLo := false
    curPdh := pdh
    curPdl := pdl
if not na(curPdh) and high > curPdh
    swHi := true
if not na(curPdl) and low < curPdl
    swLo := true
dayClose := close

n = array.size(oHiA)
shN = 0
slN = 0
eiN = 0
boN = 0
rejN = 0
accN = 0
for i = 0 to math.max(n - 1, 0)
    if i < n
        a = array.get(sHiA, i)
        b = array.get(sLoA, i)
        if a
            shN += 1
        if b
            slN += 1
        if a or b
            eiN += 1
        if a and b
            boN += 1
        if array.get(oHiA, i) == 1
            rejN += 1
        else if array.get(oHiA, i) == 2
            accN += 1
        if array.get(oLoA, i) == 1
            rejN += 1
        else if array.get(oLoA, i) == 2
            accN += 1
pct(x, y) => y > 0 ? 100.0 * x / y : 0.0

sdH = stHi(pdh, dh, dc)
sdL = stLo(pdl, dl, dc)
swH = stHi(pwh, wh, wc)
swL = stLo(pwl, wl, wc)
smH = stHi(pmh, mh, mc)
smL = stLo(pml, ml, mc)
stateTxt(s) => s == 0 ? "untouched" : s == 1 ? "swept, back inside" : "accepted beyond"
stateCol(s, base) => s == 0 ? base : s == 1 ? color.orange : color.red

var line[] lines = array.new_line()
var label[] labels = array.new_label()
drawLevel(nm, lvl, st, base, start) =>
    if not na(lvl) and not na(start)
        c = stateCol(st, base)
        array.push(lines, line.new(start, lvl, start + 86400000, lvl, xloc=xloc.bar_time, extend=extend.right, color=c, style=st == 0 ? line.style_solid : line.style_dashed))
        array.push(labels, label.new(time, lvl, nm + " " + str.tostring(lvl, format.mintick) + (st == 0 ? "" : st == 1 ? " swept" : " accepted"), xloc=xloc.bar_time, style=label.style_none, textcolor=c, size=size.small))
    0

if barstate.islast
    for i = 0 to math.max(array.size(lines) - 1, 0)
        if array.size(lines) > 0 and i < array.size(lines)
            line.delete(array.get(lines, i))
    for i = 0 to math.max(array.size(labels) - 1, 0)
        if array.size(labels) > 0 and i < array.size(labels)
            label.delete(array.get(labels, i))
    array.clear(lines)
    array.clear(labels)
    drawLevel("PDH", pdh, sdH, dayCol, dStart)
    drawLevel("PDL", pdl, sdL, dayCol, dStart)
    if showW
        drawLevel("PWH", pwh, swH, weekCol, wStart)
        drawLevel("PWL", pwl, swL, weekCol, wStart)
    if showM
        drawLevel("PMH", pmh, smH, monthCol, mStart)
        drawLevel("PML", pml, smL, monthCol, mStart)

pos = switch dashPos
    "top left" => position.top_left
    "top right" => position.top_right
    "bottom left" => position.bottom_left
    => position.bottom_right
var table t = table.new(pos, 2, 12, bgcolor=color.new(#0C1628, 0), border_color=color.new(#C8A03C, 0), border_width=1, frame_color=color.new(#C8A03C, 0), frame_width=1)
tableRow(r, nm, lvl, st, base) =>
    table.cell(t, 0, r, nm + " " + (na(lvl) ? "n/a" : str.tostring(lvl, format.mintick)), text_color=base, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, r, stateTxt(st), text_color=stateCol(st, color.white), text_size=size.small, text_halign=text.align_left)
    0

if showDash and barstate.islast
    table.cell(t, 0, 0, "AT24", text_color=#E8B84A, text_size=size.large)
    table.cell(t, 1, 0, "LIQUIDITY LEVELS", text_color=#E8B84A, text_size=size.normal, text_halign=text.align_left)
    tableRow(1, "PDH", pdh, sdH, dayCol)
    tableRow(2, "PDL", pdl, sdL, dayCol)
    tableRow(3, "PWH", pwh, swH, weekCol)
    tableRow(4, "PWL", pwl, swL, weekCol)
    tableRow(5, "PMH", pmh, smH, monthCol)
    tableRow(6, "PML", pml, smL, monthCol)
    table.cell(t, 0, 7, "Days analysed", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 7, str.tostring(n), text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 8, "Swept", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 8, "PDH " + str.tostring(pct(shN, n), "0") + "%  PDL " + str.tostring(pct(slN, n), "0") + "%  either " + str.tostring(pct(eiN, n), "0") + "%", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 9, "After a sweep", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 9, "back inside " + str.tostring(pct(rejN, rejN + accN), "0") + "%  accepted " + str.tostring(pct(accN, rejN + accN), "0") + "%", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 0, 10, "Descriptive history.", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(t, 1, 10, "Not a signal. algotraders24.ai", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)

//@version=5
// AT24 Sweep Scorecard - Asian-range sweeps graded in R with costs: reversal vs continuation vs a random-direction control.
// Research tool. Places no trades. Not a signal. algotraders24.ai
indicator("AT24 Sweep Scorecard", shorttitle="AT24 SWEEP", overlay=true, max_boxes_count=10, max_labels_count=10)

grp1 = "Setup (GMT hours)"
asiaEnd = input.int(7, "Asian range = GMT hours before this", minval=4, maxval=10, group=grp1)
winEnd = input.int(12, "Sweep window = from the Asian end to this GMT hour (inclusive)", minval=6, maxval=20, group=grp1)
exitHour = input.int(16, "Time exit at this GMT hour", minval=8, maxval=23, group=grp1)
cost = input.float(0.25, "Cost per trade in PRICE units (0.25 = 25 cents on gold)", minval=0.0, step=0.05, group=grp1)
recentN = input.int(250, "'Recent' = this many latest sweeps", minval=30, maxval=2000, group=grp1)
grp2 = "Look"
daysShown = input.int(6, "Days of Asian boxes / sweep marks drawn", minval=1, maxval=10, group=grp2)
boxCol = input.color(color.new(#3C5A8C, 75), "Asian range box", group=grp2)
grp3 = "Dashboard"
showDash = input.bool(true, "Show dashboard", group=grp3)
dashPos = input.string("top right", "Position", options=["top left","top right","bottom left","bottom right"], group=grp3)

var float[] aO = array.new_float()
var float[] aH = array.new_float()
var float[] aL = array.new_float()
var float[] aC = array.new_float()
var int[] aT = array.new_int()
var int[] aI = array.new_int()
if barstate.isconfirmed
    array.push(aO, open)
    array.push(aH, high)
    array.push(aL, low)
    array.push(aC, close)
    array.push(aT, time)
    array.push(aI, bar_index)

// one trade: enter at the open of bar idx+1 in direction d, stop at `stop`, target one `risk` away, time exit at the first bar of GMT hour >= exitHour or after maxBars
sim(int[] gday, int[] ghour, int idx, int d, float stop, float risk, int maxBars) =>
    n = array.size(gday)
    entry = array.get(aO, idx + 1)
    target = entry + d * risk
    float res = 0.0
    bool done = false
    for j = idx + 1 to math.min(idx + maxBars, n - 1)
        if array.get(gday, j) != array.get(gday, idx) or array.get(ghour, j) >= exitHour
            res := j > idx + 1 ? (array.get(aO, j) - entry) * d : 0.0
            done := true
            break
        hitStop = d == 1 ? array.get(aL, j) <= stop : array.get(aH, j) >= stop
        hitTgt = d == 1 ? array.get(aH, j) >= target : array.get(aL, j) <= target
        if hitStop
            res := -risk
            done := true
            break
        if hitTgt
            res := risk
            done := true
            break
    if not done
        res := (array.get(aC, math.min(idx + maxBars, n - 1)) - entry) * d
    (res - cost) / risk

pos = switch dashPos
    "top left" => position.top_left
    "top right" => position.top_right
    "bottom left" => position.bottom_left
    => position.bottom_right
var table t = table.new(pos, 2, 13, bgcolor=color.new(#0C1628, 0), border_color=color.new(#C8A03C, 0), border_width=1, frame_color=color.new(#C8A03C, 0), frame_width=1)
var box[] bxs = array.new_box()
var label[] lbs = array.new_label()
sg2(x) => (x >= 0 ? "+" : "") + str.tostring(x, "0.00")
sg1(x) => (x >= 0 ? "+" : "") + str.tostring(x, "0.0")

// stats over events from index `from`: [n, meanRev, tRev, hitRev, meanCont, tCont, hitCont, control, diff, tDiff, medianRisk]
stats(float[] rev, float[] cont, float[] risks, int from) =>
    m = array.size(rev)
    int n = 0
    float sr = 0.0
    float sr2 = 0.0
    float sc = 0.0
    float sc2 = 0.0
    float sd = 0.0
    float sd2 = 0.0
    int hr = 0
    int hc = 0
    rk = array.new_float()
    if m > from
        for k = from to m - 1
            r = array.get(rev, k)
            c = array.get(cont, k)
            d = (r - c) / 2.0
            n += 1
            sr += r
            sr2 += r * r
            sc += c
            sc2 += c * c
            sd += d
            sd2 += d * d
            if r > 0
                hr += 1
            if c > 0
                hc += 1
            array.push(rk, array.get(risks, k))
    float mr = 0.0
    float mc = 0.0
    float md = 0.0
    float tr = 0.0
    float tc = 0.0
    float td = 0.0
    float med = 0.0
    if n >= 3
        mr := sr / n
        mc := sc / n
        md := sd / n
        vr = (sr2 - n * mr * mr) / (n - 1)
        vc = (sc2 - n * mc * mc) / (n - 1)
        vd = (sd2 - n * md * md) / (n - 1)
        tr := vr > 0 ? mr / math.sqrt(vr / n) : 0.0
        tc := vc > 0 ? mc / math.sqrt(vc / n) : 0.0
        td := vd > 0 ? md / math.sqrt(vd / n) : 0.0
        med := array.median(rk)
    [n, mr, tr, n > 0 ? 100.0 * hr / n : 0.0, mc, tc, n > 0 ? 100.0 * hc / n : 0.0, (mr + mc) / 2.0, md, td, med]

if barstate.islast
    while array.size(bxs) > 0
        box.delete(array.pop(bxs))
    while array.size(lbs) > 0
        label.delete(array.pop(lbs))
    n = array.size(aC)
    ok = timeframe.period == "60" and n > 3000
    int[] gday = array.new_int(n, 0)
    int[] ghour = array.new_int(n, 0)
    if ok
        for i = 0 to n - 1
            tm = array.get(aT, i)
            array.set(gday, i, int(math.floor(tm / 86400000.0)))
            array.set(ghour, i, hour(tm, "GMT"))
    int[] eBar = array.new_int()
    int[] eDir = array.new_int()
    float[] eExt = array.new_float()
    float[] eHi = array.new_float()
    float[] eLo = array.new_float()
    int[] eFirst = array.new_int()
    float[] eRev = array.new_float()
    float[] eCont = array.new_float()
    float[] eRisk = array.new_float()
    if ok
        int i = 0
        while i < n
            dk = array.get(gday, i)
            int j = i
            for q = i to n - 1
                if array.get(gday, q) != dk
                    break
                j := q + 1
            int nAs = 0
            int nw = 0
            float hi = -1.0e300
            float lo = 1.0e300
            int first = -1
            for k = i to j - 1
                hk = array.get(ghour, k)
                if hk < asiaEnd
                    nAs += 1
                    if first < 0
                        first := k
                    hi := math.max(hi, array.get(aH, k))
                    lo := math.min(lo, array.get(aL, k))
                else if hk <= winEnd
                    nw += 1
            if nAs >= 6 and nw >= 4
                int sweepBar = -1
                int d = 0
                float ext = 0.0
                for k = i to j - 1
                    hk = array.get(ghour, k)
                    if hk >= asiaEnd and hk <= winEnd
                        up = array.get(aH, k) > hi and array.get(aC, k) <= hi
                        dn = array.get(aL, k) < lo and array.get(aC, k) >= lo
                        if up and dn
                            break
                        if up
                            sweepBar := k
                            d := -1
                            ext := array.get(aH, k)
                            break
                        if dn
                            sweepBar := k
                            d := 1
                            ext := array.get(aL, k)
                            break
                if sweepBar >= 0 and sweepBar + 1 < n
                    if array.get(gday, sweepBar + 1) == dk
                        entry = array.get(aO, sweepBar + 1)
                        risk = math.abs(entry - ext)
                        if risk > 0.5
                            array.push(eBar, sweepBar)
                            array.push(eDir, d)
                            array.push(eExt, ext)
                            array.push(eHi, hi)
                            array.push(eLo, lo)
                            array.push(eFirst, first)
                            array.push(eRisk, risk)
                            array.push(eRev, sim(gday, ghour, sweepBar, d, ext, risk, 11))
                            array.push(eCont, sim(gday, ghour, sweepBar, -d, entry + d * risk, risk, 11))
            i := j
    m = array.size(eBar)
    [nA, mrA, trA, hrA, mcA, tcA, hcA, ctlA, mdA, tdA, medA] = stats(eRev, eCont, eRisk, 0)
    [nR, mrR, trR, hrR, mcR, tcR, hcR, ctlR, mdR, tdR, medR] = stats(eRev, eCont, eRisk, math.max(0, m - recentN))
    // state of the current GMT day from closed bars
    string todayInfo = "WAITING FOR TODAY'S ASIAN RANGE"
    int todayState = 0
    if ok
        dk2 = array.get(gday, n - 1)
        int i2 = n - 1
        for q = n - 1 to 1
            if array.get(gday, q - 1) == dk2
                i2 := q - 1
            else
                break
        int na2 = 0
        float hi2 = -1.0e300
        float lo2 = 1.0e300
        for k = i2 to n - 1
            if array.get(ghour, k) < asiaEnd
                na2 += 1
                hi2 := math.max(hi2, array.get(aH, k))
                lo2 := math.min(lo2, array.get(aL, k))
        if array.get(ghour, n - 1) < asiaEnd
            todayInfo := "ASIAN RANGE FORMING (" + str.tostring(na2) + " bars)"
        else if na2 < 6
            todayInfo := "NO FULL ASIAN RANGE TODAY"
        else
            todayState := 1
            todayInfo := "RANGE " + str.tostring(lo2, format.mintick) + " - " + str.tostring(hi2, format.mintick) + ", WATCHING FOR A SWEEP"
            bool found = false
            for k = i2 to n - 1
                hk = array.get(ghour, k)
                if hk >= asiaEnd and hk <= winEnd and not found
                    up = array.get(aH, k) > hi2 and array.get(aC, k) <= hi2
                    dn = array.get(aL, k) < lo2 and array.get(aC, k) >= lo2
                    if up and dn
                        todayState := 4
                        todayInfo := "BOTH SIDES SWEPT: NO SETUP TODAY"
                        found := true
                    else if up
                        todayState := 2
                        todayInfo := "HIGH SWEPT at " + str.format_time(array.get(aT, k), "HH:mm") + " (reversal = short)"
                        found := true
                    else if dn
                        todayState := 3
                        todayInfo := "LOW SWEPT at " + str.format_time(array.get(aT, k), "HH:mm") + " (reversal = long)"
                        found := true
            if not found and array.get(ghour, n - 1) > winEnd
                todayState := 4
                todayInfo := "WINDOW OVER: NO SWEEP TODAY"
    // boxes and marks for the latest sweeps
    if m > 0
        int shown = 0
        for k = m - 1 to 0
            if shown < daysShown
                shown += 1
                bi = array.get(aI, array.get(eBar, k))
                b0 = array.get(aI, array.get(eFirst, k))
                array.push(bxs, box.new(b0, array.get(eHi, k), bi + 3, array.get(eLo, k), border_color=color.new(color.gray, 100), bgcolor=boxCol))
                win = array.get(eRev, k) > 0
                array.push(lbs, label.new(bi, array.get(eExt, k), (array.get(eDir, k) == -1 ? "high" : "low") + " sweep: reversal " + sg1(array.get(eRev, k)) + "R", style=array.get(eDir, k) == -1 ? label.style_label_down : label.style_label_up, color=color.new(win ? color.green : color.red, 20), textcolor=color.white, size=size.tiny))
    vTxt = trA <= -2.0 ? "THIS SETUP HAS LOST MONEY (net of costs)" : trA >= 2.0 ? "THIS SETUP HAS MADE MONEY (net of costs)" : "NOT CLEARLY DIFFERENT FROM ZERO"
    vCol = trA <= -2.0 ? color.red : trA >= 2.0 ? color.lime : #E6B450
    if showDash
        table.cell(t, 0, 0, "AT24", text_color=#E8B84A, text_size=size.large)
        table.cell(t, 1, 0, "SWEEP SCORECARD", text_color=#E8B84A, text_size=size.normal, text_halign=text.align_left)
        if not ok or m < 30
            table.cell(t, 0, 1, "State", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 1, not ok ? "USE THE 1H CHART (NEED 3,000+ BARS)" : "NOT ENOUGH SWEEPS YET", text_color=color.gray, text_size=size.normal, text_halign=text.align_left)
        else
            since = str.format_time(array.get(aT, 0), "yyyy-MM-dd")
            table.cell(t, 0, 1, "Today", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 1, todayInfo, text_color=todayState == 2 or todayState == 3 ? #E6B450 : color.white, text_size=size.normal, text_halign=text.align_left)
            table.cell(t, 0, 2, "Sweeps", text_color=#E8B84A, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 2, str.tostring(m) + " Asian-range sweeps since " + since + ", graded in R", text_color=#E8B84A, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 3, "Reversal", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 3, sg2(mrA) + " R per trade  (hit " + str.tostring(hrA, "0") + "%, t " + sg1(trA) + ")", text_color=mrA < 0 ? color.red : color.lime, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 4, "Continuation", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 4, sg2(mcA) + " R per trade  (hit " + str.tostring(hcA, "0") + "%)", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 5, "Control", text_color=color.silver, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 5, "random direction " + sg2(ctlA) + " R", text_color=color.silver, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 6, "Rev - control", text_color=color.silver, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 6, sg2(mdA) + " R  (t " + sg1(tdA) + ")", text_color=color.silver, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 7, "Latest", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 7, str.tostring(nR) + " sweeps: reversal " + sg2(mrR) + " R (t " + sg1(trR) + "), control " + sg2(ctlR) + " R", text_color=color.white, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 8, "Verdict", text_color=vCol, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 8, vTxt, text_color=vCol, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 9, "Terms", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 9, "1R = entry to sweep extreme (typical " + str.tostring(medA, "0.00") + "). Target 1R, stop at the extreme, exit GMT " + str.tostring(exitHour, "00") + ":00, cost " + str.tostring(cost, "0.00") + ", ties = stop.", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 10, "Read it", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 1, 10, "Compare the reversal with the control, not with zero.", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
            table.cell(t, 0, 11, "Descriptive history.", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
            table.cell(t, 1, 11, "Research tool, not a signal. No trades placed. algotraders24.ai", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)

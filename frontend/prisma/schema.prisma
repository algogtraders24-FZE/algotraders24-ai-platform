// Sprint 14B - Prisma models mapped to Sprint 14A entity shapes.
// Sprint 14C - Added authId + emailVerified to User for Supabase Auth.
// Sprint 14D - Added deletedAt (soft delete) to every model.
// Sprint 14D Phase 1 - Added Plan + Subscription models.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  authId           String?   @unique
  email            String    @unique
  name             String
  role             String    @default("user")
  planId           String    @default("free")
  status           String    @default("active")
  emailVerified    Boolean   @default(false)
  // Sprint L2.7 - real Stripe Customer link (one customer per user, reused
  // across checkout sessions/subscriptions). Null until the user's first
  // real checkout - never fabricated.
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([authId])
  @@index([deletedAt])
}

model Plan {
  id        String    @id
  name      String
  price     Float     @default(0)
  interval  String    @default("month")
  features  String[]  @default([])
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  planId               String
  status               String    @default("active")
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  // Sprint L2.7 - real payment-provider linkage, populated only by a
  // verified webhook event (checkout completion / IPN), never by the
  // self-service or admin-override paths (those leave these null - "free"
  // and admin-granted plans have no real provider behind them, and must
  // never claim one).
  provider             String?
  stripeSubscriptionId String?   @unique
  nowPaymentsInvoiceId String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([userId])
  @@index([deletedAt])
}

model Product {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  shortDescription   String    @default("")
  fullDescription    String    @default("")
  category           String    @default("mt5-expert-advisors")
  platform           String    @default("")
  supportedPlatforms String[]  @default([])
  tags               String[]  @default([])
  price              Float     @default(0)
  currency           String    @default("USD")
  images             String[]  @default([])
  features           String[]  @default([])
  specifications     Json      @default("[]")
  faqs               Json      @default("[]")
  version            String    @default("1.0.0")
  releaseDate        String    @default("")
  lastUpdated        String    @default("")
  rating             Float     @default(0)
  downloads          Int       @default(0)
  featured           Boolean   @default(false)
  status             String    @default("active")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([category])
  @@index([featured])
  @@index([deletedAt])
}

model Conversation {
  id            String    @id @default(cuid())
  userId        String
  title         String
  messageCount  Int       @default(0)
  lastMessageAt DateTime  @default(now())
  archived      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  /// Sprint D2.6.7 - persisted PersistedConversationContext (types/conversation-context.ts).
  /// Null for a conversation with no resolved market-intelligence turn yet.
  /// Context only - symbol/timeframe/analysis-run pointers, never a market
  /// fact itself (see that type's own header for the honesty boundary).
  intelligenceContext Json?

  messages Message[]

  @@index([userId])
  @@index([deletedAt])
}

// Sprint 15C.3 - Server-side message persistence for a Conversation.
// Immutable append-only turn (like AgentActivity): no updatedAt, content is
// never edited in place. userId is denormalized onto the row (same pattern
// as KnowledgeChunk.userId) so ownership can be enforced directly in a
// scoped query without an extra join.
model Message {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  role           String
  content        String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([deletedAt])
}

model Agent {
  id             String    @id @default(cuid())
  userId         String
  type           String
  name           String
  description    String    @default("")
  avatar         String    @default("")
  status         String    @default("idle")
  provider       String    @default("gemini")
  version        String    @default("1.0.0")
  memoryEnabled  Boolean   @default(true)
  tools          String[]  @default([])
  capabilities   String[]  @default([])
  goal           String    @default("")
  priority       Int       @default(3)
  lastRun        DateTime?
  nextRun        DateTime?
  tasksCompleted Int       @default(0)
  successRate    Int       @default(0)
  estimatedCost  Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([userId])
  @@index([type])
  @@index([deletedAt])
}

model AgentTask {
  id         String    @id @default(cuid())
  agentId    String
  userId     String
  title      String
  status     String    @default("queued")
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([agentId])
  @@index([userId])
  @@index([deletedAt])
}

model AgentMemory {
  id        String    @id @default(cuid())
  agentId   String
  userId    String
  key       String
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([agentId])
  @@index([userId])
  @@index([deletedAt])
}

model AgentActivity {
  id        String    @id @default(cuid())
  agentId   String
  userId    String
  message   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([agentId])
  @@index([userId])
  @@index([deletedAt])
}

model Automation {
  id        String    @id @default(cuid())
  userId    String
  name      String
  trigger   String
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([deletedAt])
}

model Knowledge {
  id              String           @id @default(cuid())
  userId          String
  title           String
  description     String           @default("")
  category        String           @default("general")
  collectionId    String?
  author          String           @default("")
  tags            String[]         @default([])
  provider        String           @default("gemini")
  language        String           @default("en")
  fileType        String           @default("md")
  documentSize    Int              @default(0)
  source          String
  chunkCount      Int              @default(0)
  status          String           @default("processing")
  embeddingStatus String           @default("pending")
  lastIndexed     DateTime?
  retrievalCount  Int              @default(0)
  popularity      Int              @default(0)
  chunks          KnowledgeChunk[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([category])
  @@index([collectionId])
  @@index([deletedAt])
}

model KnowledgeCollection {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([deletedAt])
}

model Billing {
  id        String    @id @default(cuid())
  userId    String
  planId    String
  status    String    @default("active")
  amount    Float     @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([deletedAt])
}

// ── Sprint 14E: Automation (Workflow) dashboard models ──────────────
// World B — dashboard-facing. Separate from the simple `Automation` model.

enum WorkflowTrigger {
  manual
  scheduled
  event
}

enum WorkflowStatus {
  active
  paused
  draft
}

enum RunStatus {
  queued
  running
  success
  failed
}

model Workflow {
  id          String          @id @default(cuid())
  userId      String
  name        String
  description String          @default("")
  trigger     WorkflowTrigger @default(manual)
  schedule    String?
  status      WorkflowStatus  @default(draft)
  steps       Json            @default("[]")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  runs  WorkflowRun[]
  queue WorkflowQueueItem[]

  @@index([userId])
  @@index([userId, status])
  @@map("workflows")
}

model WorkflowRun {
  id         String    @id @default(cuid())
  workflowId String
  userId     String
  status     RunStatus @default(queued)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  log        Json      @default("[]")
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@map("workflow_runs")
}

model WorkflowQueueItem {
  id         String    @id @default(cuid())
  workflowId String
  userId     String
  status     RunStatus @default(queued)
  enqueuedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workflow_queue_items")
}

model KnowledgeChunk {
  id          String    @id @default(cuid())
  knowledgeId String
  userId      String
  content     String
  chunkIndex  Int
  tokenCount  Int       @default(0)
  charCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  knowledge Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@index([knowledgeId])
  @@index([userId])
  @@index([deletedAt])
}

// Sprint L2.6 - Immutable, append-only record of every admin action (Phase 7:
// Audit Logs). Deliberately has no `deletedAt`/soft-delete and no update path
// anywhere in the app - an audit trail that could be edited or erased by the
// same admins it records would defeat its purpose. Mirrors AgentActivity's
// simple append-only shape. `targetId` is nullable for actions with no single
// target (e.g. viewing a list); `metadata` carries the real before/after
// values of a mutation, never a summary invented after the fact.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Sprint L2.7 - Phase 6: durable, real per-request counters for the two
// metrics L2.5/L2.6 disclosed as "not yet tracked" (no durable record
// existed anywhere - AnalysisRun is in-memory only, and knowledge search
// never logged an event). Append-only, immutable, no update path - a pure
// event log. Written by a single additive, best-effort line at the end of
// the two route files, never by the reasoning/embedding logic itself.
model RequestLog {
  id        String   @id @default(cuid())
  userId    String
  type      String // "market_analysis" | "knowledge_search"
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// Sprint R1.2 - Phase 1: real user feedback (Bug Report / Feature Request /
// General Feedback), reviewable by an admin. Unlike AuditLog/RequestLog this
// one does have an update path (status), since "admin can review feedback"
// requires a real reviewed/resolved transition - but no delete path, and
// no field here is ever synthesized (message is always the user's own text).
model Feedback {
  id        String    @id @default(cuid())
  userId    String
  type      String // "bug" | "feature" | "general"
  message   String
  page      String    @default("") // route the feedback was submitted from, for admin triage
  status    String    @default("open") // "open" | "reviewed" | "resolved"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// Sprint R1.2 - Phase 2: internal beta analytics event log (explicitly not a
// third-party analytics integration, per the sprint brief). Append-only, no
// update/delete path - the same pure-event-log shape as RequestLog. userId is
// nullable because "product_view" can happen on the public product page
// before a visitor ever signs up; every other event type is always fired
// with a real, session-derived userId (see the call sites - never a body-
// supplied one). "First X" milestones (Phase 3's journey) are never a
// separate flag on this table - they're derived by taking MIN(createdAt) per
// user/type, so there's no separate "is this the first one" bookkeeping that
// could ever drift out of sync with the raw event history.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String // "login" | "email_verified" | "ai_chat" | "knowledge_upload" | "market_analysis" | "subscription_click" | "product_view"
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([userId, type])
  @@index([createdAt])
}

// Sprint D2.3 - Phase 7: Workspace Profiles. Presentation-layer preferences
// only - never read by the AI Intelligence pipeline (TradingCopilotService /
// CopilotAnalysis take no input from this table). One row per user
// (upserted on first workspace visit). `chartInterval` drives the
// TradingView widget's own display interval only, not any analysis
// timeframe - the real pipeline has no timeframe parameter to personalize.
// `sidebarCollapsed`/`theme` are forward-ready fields with no UI consumer
// yet (mirrors this sprint's own "theme preference (future-ready)" scoping).
model WorkspacePreference {
  id               String    @id @default(cuid())
  userId           String    @unique
  profile          String    @default("default") // "default" | "scalper" | "day_trader" | "swing_trader" | "investor"
  symbol           String? // last/default active symbol; null = fall back to market-registry default
  chartInterval    String    @default("D") // TradingView widget interval code
  favoriteMarkets  String[]  @default([]) // ordered canonical symbols, registry-validated
  collapsedPanels  String[]  @default([]) // subset of the workspace's collapsible panel ids
  sidebarCollapsed Boolean   @default(false)
  theme            String    @default("dark")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([userId])
  @@index([deletedAt])
}

// Sprint D2.7.11 Phase 1b - durable, cross-session persistence for chart
// drawn objects (trend lines, horizontal lines, rectangles, Fibonacci
// retracements - lib/chart-engine/drawing/types.ts's DrawingObject union).
// Previously sessionStorage only (lib/chart-engine/drawing/store.ts) - tab-
// scoped, gone on tab close. One row per (userId, symbol, timeframe) - the
// exact same compound key store.ts's sessionStorage entries already used -
// `objects` is the full JSON array for that key, always written as a
// whole-array replace (never per-object CRUD), matching NativeChart.tsx's
// existing commitDrawingObjects()/writeDrawingObjects() semantics exactly,
// so the client-side object model and component logic needed no redesign,
// only a swap from sync sessionStorage calls to async fetch calls.
model ChartDrawingSet {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  timeframe String
  objects   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol, timeframe])
  @@index([userId])
}

// Sprint D2.3.S1 - Publishing Activation. Real, DB-backed article state:
// before this, the Publishing dashboard rendered hardcoded mock data with no
// persistence and no working Publish/Schedule actions (Master Audit D2.3.F,
// Critical finding #1). Website-channel scope only for this pass - no
// Telegram/Twitter/LinkedIn/newsletter/RSS dispatch (see
// services/ai/publishing/publisher.service.ts's SUPPORTED_CHANNELS, which
// stays a reference list for a future multi-channel pass; runJob() there
// remains a documented placeholder). `history` is an append-only log
// (create/generate/edit/schedule/publish/delete), same lightweight pattern
// WorkflowRun.log already uses in this schema - this is what makes the
// audit's "History" finding real rather than another status flag.
enum ArticleStatus {
  draft
  scheduled
  published
  failed
}

// Architectural constraint (not yet full version-history, deliberately -
// see services/publishing/article.service.ts's update()): once `status` is
// `published`, this row is read-only - the service layer rejects further
// edits rather than letting a published article silently change under a
// reader who already saw it. Revising means duplicateAsDraft() (a new row),
// never an in-place edit. If a full version-history table is ever needed
// (e.g. to show a diff between revisions), this is the seam to add it at -
// the read-only guarantee above means today's single-row model is already
// a safe foundation for that, not a shortcut that would need undoing.
model Article {
  id           String        @id @default(cuid())
  userId       String
  title        String
  category     String
  summary      String        @default("")
  sections     Json          @default("[]") // ArticleSection[]
  disclaimer   String        @default("This is not financial advice. Trading involves risk.")
  seo          Json          @default("{}") // SeoMetadata (title/metaDescription/keywords/slug/canonicalUrl/openGraph/twitter/score)
  slug         String
  status       ArticleStatus @default(draft)
  sourceType   String        @default("manual") // "ai" | "manual" | "imported" | "research"
  scheduledFor DateTime?
  publishedAt  DateTime?
  history      Json          @default("[]") // { action, actor, timestamp, metadata? }[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@unique([userId, slug])
  @@index([userId])
  @@index([userId, status])
  @@index([deletedAt])
  @@map("articles")
}

// Sprint D2.5.1 - Persistent Analysis & Outcome Foundation (Intelligence
// Engine V2, phase 1). Deliberately distinct from the existing, in-memory-
// only `AnalysisRun` domain type (services/ai/analysis-run.service.ts,
// types/analysis-run.ts) - that one tracks a single orchestration API call
// (pending/completed/unavailable/failed) and is NOT being replaced or
// touched here. This model is the new, durable Intelligence Memory record:
// it persists a completed deterministic analysis snapshot so it can later
// be compared against what actually happened in the market. Named
// `IntelligenceAnalysisRun`/`IntelligenceAnalysisOutcome` (not bare
// `AnalysisRun`/`AnalysisOutcome`) specifically to avoid the exact kind of
// name collision this codebase has repeatedly flagged and avoided
// elsewhere (types/market-analysis.ts vs types/market-analysis-
// orchestration.ts; types/market-intelligence.ts vs types/market-
// intelligence-result.ts).
//
// `analysisResult` stores the real, deterministic `MarketIntelligenceResult`
// (evidence + reasoning + risk + confidence - zero AI-authored content) as
// JSON - never the Gemini-touched `MarketAnalysisResult.summary`, per the
// sprint's rule that no LLM output may create or modify these facts.
// `regimeAtTime` is always null in D2.5.1: no Regime Engine exists yet
// (confirmed by the D2.5.0 audit) - typed as Json, not a real Regime shape,
// so a future sprint can populate it without a breaking schema change.
//
// Sprint D2.5.4 - added `hypothesisSnapshot` (additive, nullable): the
// real, complete D2.5.2/D2.5.3 MarketState + Regime + Hypothesis[] as they
// existed AT CREATION TIME, stored as JSON (types/intelligence-hypothesis-
// snapshot.ts#HypothesisSnapshot). This is the "creation-time snapshot"
// the D2.5.4 evaluator reads from - it never recalculates the original
// hypothesis from today's market state. `regimeAtTime` above stays
// untouched/still-always-null; the richer snapshot lives in this new,
// separate column rather than repurposing that one, so its own
// documented meaning ("reserved for a future Regime Engine's raw output")
// isn't redefined out from under it.
enum IntelligenceAnalysisRunEvaluationStatus {
  pending
  evaluated
}

model IntelligenceAnalysisRun {
  id                 String    @id @default(cuid())
  userId             String
  symbol             String
  timeframe          String
  // Real value from MarketIntelligenceResult.metadata.pipelineVersion (e.g.
  // "15D.12.0") when analysisResult is present; null when it isn't - never
  // invented.
  pipelineVersion    String?
  // The real, deterministic MarketIntelligenceResult snapshot (JSON). Null
  // only when genuinely unavailable (e.g. a provider-unavailable run) -
  // never a fabricated placeholder.
  analysisResult     Json?
  // Always null in D2.5.1 - see header comment. Reserved for a future
  // Regime Engine's real output.
  regimeAtTime       Json?
  // Sprint D2.5.4 - the real, complete MarketState + Regime + Hypothesis[]
  // creation-time snapshot (HypothesisSnapshot). Null for runs created
  // before D2.5.4, or any run with no real hypothesis to snapshot.
  hypothesisSnapshot Json?
  evaluationStatus   IntelligenceAnalysisRunEvaluationStatus @default(pending)
  createdAt          DateTime  @default(now())
  deletedAt          DateTime?

  outcomes IntelligenceAnalysisOutcome[]

  @@index([userId])
  @@index([symbol])
  @@index([evaluationStatus])
  @@index([deletedAt])
  @@map("intelligence_analysis_runs")
}

enum IntelligenceAnalysisOutcomeStatus {
  pending
  validated
  invalidated
  inconclusive
}

// D2.5.1 had no Hypothesis Engine, so "validated"/"invalidated" were
// structurally unreachable then - see services/intelligence/memory/
// outcome-evaluator.service.ts (still true for that evaluator, which
// remains unchanged). Sprint D2.5.4 adds a second, hypothesis-aware
// evaluator (services/intelligence/hypothesis/hypothesis-outcome-
// evaluator.service.ts) that DOES reach validated/invalidated for real,
// once a hypothesisId/hypothesisType/regimeType are genuinely known.
model IntelligenceAnalysisOutcome {
  id                 String    @id @default(cuid())
  analysisRunId      String
  // Real (matches a Hypothesis.id from the parent run's hypothesisSnapshot)
  // as of D2.5.4, when the outcome evaluates a real hypothesis. Still null
  // for outcomes produced by D2.5.1's original, hypothesis-unaware
  // evaluator.
  hypothesisId       String?
  // Sprint D2.5.4 - denormalized from the evaluated Hypothesis/Regime at
  // evaluation time, purely for efficient historical-validation
  // segmentation (services/intelligence/memory/historical-validation
  // .service.ts) - never a second, independently-editable source of
  // truth; always copied from the real hypothesisSnapshot, never entered
  // separately.
  hypothesisType     String?
  regimeType         String?
  evaluatedAt        DateTime?
  status             IntelligenceAnalysisOutcomeStatus @default(pending)
  // Real, computed only when a price-type evidence item at analysis time
  // AND a real current snapshot are both available - never estimated.
  actualPriceMovePct Float?
  // Always null in D2.5.1 - no Regime Engine exists yet.
  actualRegimeAfter  Json?
  // Required, human-readable: always states exactly why this status was
  // assigned - never a bare score with no explanation. As of D2.5.4, a
  // JSON-serialized structured object for every non-"pending-from-
  // creation" outcome - see HypothesisEvaluationBasis.
  evaluationBasis    String
  createdAt          DateTime  @default(now())

  analysisRun IntelligenceAnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId])
  @@index([status])
  @@index([createdAt])
  @@index([hypothesisType])
  @@index([regimeType])
  @@map("intelligence_analysis_outcomes")
}

// Sprint D2.7.9 - Historical Validation Production Wiring. A partial unique
// index (NOT expressible as a Prisma `@@unique` here - Prisma has no WHERE
// clause on indexes, so this is enforced only in the hand-written migration
// prisma/migrations/*_add_outcome_idempotency_guard/migration.sql) exists on
// intelligence_analysis_outcomes("analysisRunId", "hypothesisId") WHERE
// "hypothesisId" IS NOT NULL AND "status" IN ('validated', 'invalidated').
// This is the DB-level concurrency backstop for
// HypothesisOutcomeEvaluatorService.evaluateAnalysisRun()'s idempotency
// check: two concurrent evaluator invocations can no longer both persist a
// finalized verdict for the same hypothesis. "pending"/"inconclusive"
// outcomes are deliberately excluded from the constraint - they remain
// retryable by design (a transient provider failure deserves another real
// attempt on the next trigger run).

// Sprint D2.6.9 - Verified Intelligence Audit, Explainability & Answer
// Traceability. The immutable, per-presented-answer audit record - see
// types/intelligence-audit-trace.ts's header for the full contract this
// mirrors. Created only for a resolved real-time intelligence turn whose
// envelope was actually handed to the D2.6.8 AI Presenter Orchestrator;
// never mutated after creation (services/intelligence/audit/audit-trace
// .service.ts enforces create-only - no update method exists). userId is
// denormalized and indexed, not FK-constrained to User, matching
// IntelligenceAnalysisRun's own established convention above. No
// deletedAt - historical immutability means a later re-analysis creates
// a NEW row, it never soft-deletes or rewrites this one.
model IntelligenceAuditTrace {
  id                       String   @id @default(cuid())
  userId                   String
  conversationId           String?
  // Loose reference (like PersistedConversationContext.lastAnalysisRunId)
  // - not a hard FK, so this trace survives independently of the
  // analysis run's own lifecycle.
  analysisRunId            String?
  symbol                   String
  timeframe                String
  queryType                String
  completeness             String
  decisionState            String
  generatedAt              DateTime
  intelligenceEngineVersion String
  pipelineVersion          String
  // Real AuditMarketDataProvenance (provider/freshness/reliability/cross-
  // provider-validation) - never secrets, never a raw provider payload.
  marketData               Json
  // Full, immutable copies of the real envelope/decision-context at
  // analysis time - see types/intelligence-audit-trace.ts's header for
  // why this pair, and only this pair, is stored in full.
  envelopeSnapshot         Json
  decisionContextSnapshot  Json
  relevanceBasis           Json
  missingContext           Json
  // Real AuditPresenterTrace (provider attempts, safe integrity-
  // violation-kind vocabulary only, fallbackUsed) - never raw provider
  // error text, never an API key.
  presenterTrace           Json
  integrityResult          Json
  claimTrace               Json
  responseGeneratedAt      DateTime
  createdAt                DateTime @default(now())
  version                  String

  @@index([userId])
  @@index([conversationId])
  @@index([analysisRunId])
  @@index([createdAt])
  @@map("intelligence_audit_traces")
}

// ============================================================================
// Sprint M8 - AT24 Marketplace. Additive-only; NOT applied to the live
// database this sprint (schema drafted + migration generated, not run -
// see ea-research/marketplace-research/m8-marketplace-platform/ for the
// full architecture audit and the reasoning below). Deliberately NOT
// connected to Product (which continues to power /products, untouched) -
// these are two parallel catalogs by design this sprint, not one migrated
// into the other. See M8_entity_relationship.md for the complete reasoning.
//
// tradingSystemId/versionId are plain identifier strings, not live Prisma
// relations: TradingSystem/Version/Evidence/Validation/RiskAnalysis/
// HistoryEvent/TrustStatus all remain M1_schema.prisma drafts (never
// applied to this file, across M1-M7) - there is nothing in this database
// to point a real foreign key at yet. Same reasoning for evidenceId/
// validationId/riskAnalysisId: pointers into the M2-M7 flat-file artifacts,
// not copies of their contents - this model never duplicates Evidence,
// Validation, RiskAnalysis, History, TrustStatus, or Score content.
//
// No evidenceTier field: blocked on ARCH-M1-TRUST-002 (M1's original
// BACKTEST_VERIFIED/.../AT24_VERIFIED tier vocabulary vs. M7's
// UNVERIFIED/.../SUPERSEDED trust-state vocabulary - two different,
// not-yet-reconciled concepts, documented not resolved here).
//
// trustState/publicationState are two separate columns on purpose (M8
// brief section 17/25) - a listing can be PUBLISHED with
// trustState=INCONCLUSIVE; the two are never equated in this sprint's code.
model MarketplaceListing {
  id   String @id @default(cuid())
  slug String @unique

  // --- Seller-authored presentation fields ---------------------------------
  // AT24-controlled fields (below) are never seller-writable; enforced in
  // the service/API layer, not just by convention - see
  // MarketplaceListingService and the marketplace API route handlers.
  sellerId    String
  title       String
  description String   @default("")
  media       String[] @default([])
  pricing     Json     @default("{}")
  category    String   @default("") // strategy category tag (trend/breakout/mean-reversion/liquidity/etc.)
  platformTag String   @default("") // MT5 / MT4 / cTrader / NinjaTrader / Crypto / AI Engine
  assetTag    String   @default("") // Gold / Silver / Forex / Indices / Crypto / etc.
  tags        String[] @default([])

  // --- Identity references (plain strings, not live FKs - see model comment) ---
  tradingSystemId String?
  versionId       String?

  // --- AT24-computed reference + outcome fields (never seller-writable) ---
  evidenceId       String?
  evidenceHash     String?
  validationId     String?
  validationHash   String?
  riskAnalysisId   String?
  riskAnalysisHash String?
  trustState       String? // M7 vocabulary: UNVERIFIED|VALIDATION_PENDING|INCONCLUSIVE|LIMITED|UNDER_OBSERVATION|VALIDATED|INVALIDATED|SUPERSEDED
  trustReasonCode  String?
  trustExplanation String  @default("")
  trustStatusId    String?
  lastEvidenceAt   DateTime? // observedAt of the most recent Evidence referenced above - a timestamp, not evidence content; lets catalog sort by "Most Recent Evidence" (M8 section 20) without joining the full Evidence record

  // --- Marketplace workflow state - separate axis from trustState ---------
  publicationState String @default("DRAFT") // DRAFT|SUBMITTED|UNDER_REVIEW|EVIDENCE_PENDING|VALIDATION_PENDING|READY|PUBLISHED|SUSPENDED|RETIRED

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([sellerId])
  @@index([publicationState])
  @@index([trustState])
  @@index([platformTag])
  @@index([assetTag])
  @@index([category])
  @@index([deletedAt])
  @@map("marketplace_listings")
}

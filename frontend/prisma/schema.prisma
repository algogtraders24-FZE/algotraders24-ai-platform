// Sprint 14B - Prisma models mapped to Sprint 14A entity shapes.
// Sprint 14C - Added authId + emailVerified to User for Supabase Auth.
// Sprint 14D - Added deletedAt (soft delete) to every model.
// Sprint 14D Phase 1 - Added Plan + Subscription models.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  authId           String?   @unique
  email            String    @unique
  name             String
  role             String    @default("user")
  planId           String    @default("free")
  status           String    @default("active")
  emailVerified    Boolean   @default(false)
  // Sprint L2.7 - real Stripe Customer link (one customer per user, reused
  // across checkout sessions/subscriptions). Null until the user's first
  // real checkout - never fabricated.
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([authId])
  @@index([deletedAt])
}

model Plan {
  id        String    @id
  name      String
  price     Float     @default(0)
  interval  String    @default("month")
  features  String[]  @default([])
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  planId               String
  status               String    @default("active")
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  // Sprint L2.7 - real payment-provider linkage, populated only by a
  // verified webhook event (checkout completion / IPN), never by the
  // self-service or admin-override paths (those leave these null - "free"
  // and admin-granted plans have no real provider behind them, and must
  // never claim one).
  provider             String?
  stripeSubscriptionId String?   @unique
  nowPaymentsInvoiceId String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([userId])
  @@index([deletedAt])
}

model Product {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  shortDescription   String    @default("")
  fullDescription    String    @default("")
  category           String    @default("mt5-expert-advisors")
  platform           String    @default("")
  supportedPlatforms String[]  @default([])
  tags               String[]  @default([])
  price              Float     @default(0)
  currency           String    @default("USD")
  images             String[]  @default([])
  features           String[]  @default([])
  specifications     Json      @default("[]")
  faqs               Json      @default("[]")
  version            String    @default("1.0.0")
  releaseDate        String    @default("")
  lastUpdated        String    @default("")
  rating             Float     @default(0)
  downloads          Int       @default(0)
  featured           Boolean   @default(false)
  status             String    @default("active")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([category])
  @@index([featured])
  @@index([deletedAt])
}

model Conversation {
  id            String    @id @default(cuid())
  userId        String
  title         String
  messageCount  Int       @default(0)
  lastMessageAt DateTime  @default(now())
  archived      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  messages Message[]

  @@index([userId])
  @@index([deletedAt])
}

// Sprint 15C.3 - Server-side message persistence for a Conversation.
// Immutable append-only turn (like AgentActivity): no updatedAt, content is
// never edited in place. userId is denormalized onto the row (same pattern
// as KnowledgeChunk.userId) so ownership can be enforced directly in a
// scoped query without an extra join.
model Message {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  role           String
  content        String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([deletedAt])
}

model Agent {
  id             String    @id @default(cuid())
  userId         String
  type           String
  name           String
  description    String    @default("")
  avatar         String    @default("")
  status         String    @default("idle")
  provider       String    @default("gemini")
  version        String    @default("1.0.0")
  memoryEnabled  Boolean   @default(true)
  tools          String[]  @default([])
  capabilities   String[]  @default([])
  goal           String    @default("")
  priority       Int       @default(3)
  lastRun        DateTime?
  nextRun        DateTime?
  tasksCompleted Int       @default(0)
  successRate    Int       @default(0)
  estimatedCost  Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([userId])
  @@index([type])
  @@index([deletedAt])
}

model AgentTask {
  id         String    @id @default(cuid())
  agentId    String
  userId     String
  title      String
  status     String    @default("queued")
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([agentId])
  @@index([userId])
  @@index([deletedAt])
}

model AgentMemory {
  id        String    @id @default(cuid())
  agentId   String
  userId    String
  key       String
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([agentId])
  @@index([userId])
  @@index([deletedAt])
}

model AgentActivity {
  id        String    @id @default(cuid())
  agentId   String
  userId    String
  message   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([agentId])
  @@index([userId])
  @@index([deletedAt])
}

model Automation {
  id        String    @id @default(cuid())
  userId    String
  name      String
  trigger   String
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([deletedAt])
}

model Knowledge {
  id              String           @id @default(cuid())
  userId          String
  title           String
  description     String           @default("")
  category        String           @default("general")
  collectionId    String?
  author          String           @default("")
  tags            String[]         @default([])
  provider        String           @default("gemini")
  language        String           @default("en")
  fileType        String           @default("md")
  documentSize    Int              @default(0)
  source          String
  chunkCount      Int              @default(0)
  status          String           @default("processing")
  embeddingStatus String           @default("pending")
  lastIndexed     DateTime?
  retrievalCount  Int              @default(0)
  popularity      Int              @default(0)
  chunks          KnowledgeChunk[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([category])
  @@index([collectionId])
  @@index([deletedAt])
}

model KnowledgeCollection {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([deletedAt])
}

model Billing {
  id        String    @id @default(cuid())
  userId    String
  planId    String
  status    String    @default("active")
  amount    Float     @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([deletedAt])
}

// ── Sprint 14E: Automation (Workflow) dashboard models ──────────────
// World B — dashboard-facing. Separate from the simple `Automation` model.

enum WorkflowTrigger {
  manual
  scheduled
  event
}

enum WorkflowStatus {
  active
  paused
  draft
}

enum RunStatus {
  queued
  running
  success
  failed
}

model Workflow {
  id          String          @id @default(cuid())
  userId      String
  name        String
  description String          @default("")
  trigger     WorkflowTrigger @default(manual)
  schedule    String?
  status      WorkflowStatus  @default(draft)
  steps       Json            @default("[]")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  runs  WorkflowRun[]
  queue WorkflowQueueItem[]

  @@index([userId])
  @@index([userId, status])
  @@map("workflows")
}

model WorkflowRun {
  id         String    @id @default(cuid())
  workflowId String
  userId     String
  status     RunStatus @default(queued)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  log        Json      @default("[]")
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@map("workflow_runs")
}

model WorkflowQueueItem {
  id         String    @id @default(cuid())
  workflowId String
  userId     String
  status     RunStatus @default(queued)
  enqueuedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workflow_queue_items")
}

model KnowledgeChunk {
  id          String    @id @default(cuid())
  knowledgeId String
  userId      String
  content     String
  chunkIndex  Int
  tokenCount  Int       @default(0)
  charCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  knowledge Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@index([knowledgeId])
  @@index([userId])
  @@index([deletedAt])
}

// Sprint L2.6 - Immutable, append-only record of every admin action (Phase 7:
// Audit Logs). Deliberately has no `deletedAt`/soft-delete and no update path
// anywhere in the app - an audit trail that could be edited or erased by the
// same admins it records would defeat its purpose. Mirrors AgentActivity's
// simple append-only shape. `targetId` is nullable for actions with no single
// target (e.g. viewing a list); `metadata` carries the real before/after
// values of a mutation, never a summary invented after the fact.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Sprint L2.7 - Phase 6: durable, real per-request counters for the two
// metrics L2.5/L2.6 disclosed as "not yet tracked" (no durable record
// existed anywhere - AnalysisRun is in-memory only, and knowledge search
// never logged an event). Append-only, immutable, no update path - a pure
// event log. Written by a single additive, best-effort line at the end of
// the two route files, never by the reasoning/embedding logic itself.
model RequestLog {
  id        String   @id @default(cuid())
  userId    String
  type      String // "market_analysis" | "knowledge_search"
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

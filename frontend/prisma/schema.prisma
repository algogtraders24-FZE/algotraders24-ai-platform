// Sprint 14B - Prisma models mapped to Sprint 14A entity shapes.
// Sprint 14C - Added authId + emailVerified to User for Supabase Auth.
// Sprint 14D - Added deletedAt (soft delete) to every model.
// Sprint 14D Phase 1 - Added Plan + Subscription models.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  authId           String?   @unique
  email            String    @unique
  name             String
  role             String    @default("user")
  planId           String    @default("free")
  status           String    @default("active")
  emailVerified    Boolean   @default(false)
  // Sprint L2.7 - real Stripe Customer link (one customer per user, reused
  // across checkout sessions/subscriptions). Null until the user's first
  // real checkout - never fabricated.
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([authId])
  @@index([deletedAt])
}

model Plan {
  id        String    @id
  name      String
  price     Float     @default(0)
  interval  String    @default("month")
  features  String[]  @default([])
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  planId               String
  status               String    @default("active")
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  // Sprint L2.7 - real payment-provider linkage, populated only by a
  // verified webhook event (checkout completion / IPN), never by the
  // self-service or admin-override paths (those leave these null - "free"
  // and admin-granted plans have no real provider behind them, and must
  // never claim one).
  provider             String?
  stripeSubscriptionId String?   @unique
  nowPaymentsInvoiceId String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([userId])
  @@index([deletedAt])
}

model Product {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  shortDescription   String    @default("")
  fullDescription    String    @default("")
  category           String    @default("mt5-expert-advisors")
  platform           String    @default("")
  supportedPlatforms String[]  @default([])
  tags               String[]  @default([])
  price              Float     @default(0)
  currency           String    @default("USD")
  images             String[]  @default([])
  features           String[]  @default([])
  specifications     Json      @default("[]")
  faqs               Json      @default("[]")
  version            String    @default("1.0.0")
  releaseDate        String    @default("")
  lastUpdated        String    @default("")
  rating             Float     @default(0)
  downloads          Int       @default(0)
  featured           Boolean   @default(false)
  status             String    @default("active")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([category])
  @@index([featured])
  @@index([deletedAt])
}

model Conversation {
  id                  String    @id @default(cuid())
  userId              String
  title               String
  messageCount        Int       @default(0)
  lastMessageAt       DateTime  @default(now())
  archived            Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  /// Sprint D2.6.7 - persisted PersistedConversationContext (types/conversation-context.ts).
  /// Null for a conversation with no resolved market-intelligence turn yet.
  /// Context only - symbol/timeframe/analysis-run pointers, never a market
  /// fact itself (see that type's own header for the honesty boundary).
  intelligenceContext Json?

  messages Message[]

  @@index([userId])
  @@index([deletedAt])
}

// Sprint 15C.3 - Server-side message persistence for a Conversation.
// Immutable append-only turn (like AgentActivity): no updatedAt, content is
// never edited in place. userId is denormalized onto the row (same pattern
// as KnowledgeChunk.userId) so ownership can be enforced directly in a
// scoped query without an extra join.
model Message {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  role           String
  content        String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([deletedAt])
}

model Agent {
  id             String    @id @default(cuid())
  userId         String
  type           String
  name           String
  description    String    @default("")
  avatar         String    @default("")
  status         String    @default("idle")
  provider       String    @default("gemini")
  version        String    @default("1.0.0")
  memoryEnabled  Boolean   @default(true)
  tools          String[]  @default([])
  capabilities   String[]  @default([])
  goal           String    @default("")
  priority       Int       @default(3)
  lastRun        DateTime?
  nextRun        DateTime?
  tasksCompleted Int       @default(0)
  successRate    Int       @default(0)
  estimatedCost  Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([userId])
  @@index([type])
  @@index([deletedAt])
}

model AgentTask {
  id         String    @id @default(cuid())
  agentId    String
  userId     String
  title      String
  status     String    @default("queued")
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([agentId])
  @@index([userId])
  @@index([deletedAt])
}

model AgentMemory {
  id        String    @id @default(cuid())
  agentId   String
  userId    String
  key       String
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([agentId])
  @@index([userId])
  @@index([deletedAt])
}

model AgentActivity {
  id        String    @id @default(cuid())
  agentId   String
  userId    String
  message   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([agentId])
  @@index([userId])
  @@index([deletedAt])
}

model Automation {
  id        String    @id @default(cuid())
  userId    String
  name      String
  trigger   String
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([deletedAt])
}

model Knowledge {
  id              String           @id @default(cuid())
  userId          String
  title           String
  description     String           @default("")
  category        String           @default("general")
  collectionId    String?
  author          String           @default("")
  tags            String[]         @default([])
  provider        String           @default("gemini")
  language        String           @default("en")
  fileType        String           @default("md")
  documentSize    Int              @default(0)
  source          String
  chunkCount      Int              @default(0)
  status          String           @default("processing")
  embeddingStatus String           @default("pending")
  lastIndexed     DateTime?
  retrievalCount  Int              @default(0)
  popularity      Int              @default(0)
  chunks          KnowledgeChunk[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([category])
  @@index([collectionId])
  @@index([deletedAt])
}

model KnowledgeCollection {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([deletedAt])
}

model Billing {
  id        String    @id @default(cuid())
  userId    String
  planId    String
  status    String    @default("active")
  amount    Float     @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([deletedAt])
}

// ── Sprint 14E: Automation (Workflow) dashboard models ──────────────
// World B — dashboard-facing. Separate from the simple `Automation` model.

enum WorkflowTrigger {
  manual
  scheduled
  event
}

enum WorkflowStatus {
  active
  paused
  draft
}

enum RunStatus {
  queued
  running
  success
  failed
}

model Workflow {
  id          String          @id @default(cuid())
  userId      String
  name        String
  description String          @default("")
  trigger     WorkflowTrigger @default(manual)
  schedule    String?
  status      WorkflowStatus  @default(draft)
  steps       Json            @default("[]")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  runs  WorkflowRun[]
  queue WorkflowQueueItem[]

  @@index([userId])
  @@index([userId, status])
  @@map("workflows")
}

model WorkflowRun {
  id         String    @id @default(cuid())
  workflowId String
  userId     String
  status     RunStatus @default(queued)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  log        Json      @default("[]")
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@map("workflow_runs")
}

model WorkflowQueueItem {
  id         String    @id @default(cuid())
  workflowId String
  userId     String
  status     RunStatus @default(queued)
  enqueuedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workflow_queue_items")
}

model KnowledgeChunk {
  id          String    @id @default(cuid())
  knowledgeId String
  userId      String
  content     String
  chunkIndex  Int
  tokenCount  Int       @default(0)
  charCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  knowledge Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@index([knowledgeId])
  @@index([userId])
  @@index([deletedAt])
}

// Sprint L2.6 - Immutable, append-only record of every admin action (Phase 7:
// Audit Logs). Deliberately has no `deletedAt`/soft-delete and no update path
// anywhere in the app - an audit trail that could be edited or erased by the
// same admins it records would defeat its purpose. Mirrors AgentActivity's
// simple append-only shape. `targetId` is nullable for actions with no single
// target (e.g. viewing a list); `metadata` carries the real before/after
// values of a mutation, never a summary invented after the fact.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Sprint L2.7 - Phase 6: durable, real per-request counters for the two
// metrics L2.5/L2.6 disclosed as "not yet tracked" (no durable record
// existed anywhere - AnalysisRun is in-memory only, and knowledge search
// never logged an event). Append-only, immutable, no update path - a pure
// event log. Written by a single additive, best-effort line at the end of
// the two route files, never by the reasoning/embedding logic itself.
model RequestLog {
  id        String   @id @default(cuid())
  userId    String
  type      String // "market_analysis" | "knowledge_search"
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// Sprint R1.2 - Phase 1: real user feedback (Bug Report / Feature Request /
// General Feedback), reviewable by an admin. Unlike AuditLog/RequestLog this
// one does have an update path (status), since "admin can review feedback"
// requires a real reviewed/resolved transition - but no delete path, and
// no field here is ever synthesized (message is always the user's own text).
model Feedback {
  id        String    @id @default(cuid())
  userId    String
  type      String // "bug" | "feature" | "general"
  message   String
  page      String    @default("") // route the feedback was submitted from, for admin triage
  status    String    @default("open") // "open" | "reviewed" | "resolved"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// Sprint R1.2 - Phase 2: internal beta analytics event log (explicitly not a
// third-party analytics integration, per the sprint brief). Append-only, no
// update/delete path - the same pure-event-log shape as RequestLog. userId is
// nullable because "product_view" can happen on the public product page
// before a visitor ever signs up; every other event type is always fired
// with a real, session-derived userId (see the call sites - never a body-
// supplied one). "First X" milestones (Phase 3's journey) are never a
// separate flag on this table - they're derived by taking MIN(createdAt) per
// user/type, so there's no separate "is this the first one" bookkeeping that
// could ever drift out of sync with the raw event history.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String // "login" | "email_verified" | "ai_chat" | "knowledge_upload" | "market_analysis" | "subscription_click" | "product_view"
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([userId, type])
  @@index([createdAt])
}

// Sprint D2.3 - Phase 7: Workspace Profiles. Presentation-layer preferences
// only - never read by the AI Intelligence pipeline (TradingCopilotService /
// CopilotAnalysis take no input from this table). One row per user
// (upserted on first workspace visit). `chartInterval` drives the
// TradingView widget's own display interval only, not any analysis
// timeframe - the real pipeline has no timeframe parameter to personalize.
// `sidebarCollapsed`/`theme` are forward-ready fields with no UI consumer
// yet (mirrors this sprint's own "theme preference (future-ready)" scoping).
model WorkspacePreference {
  id               String    @id @default(cuid())
  userId           String    @unique
  profile          String    @default("default") // "default" | "scalper" | "day_trader" | "swing_trader" | "investor"
  symbol           String? // last/default active symbol; null = fall back to market-registry default
  chartInterval    String    @default("D") // TradingView widget interval code
  favoriteMarkets  String[]  @default([]) // ordered canonical symbols, registry-validated
  collapsedPanels  String[]  @default([]) // subset of the workspace's collapsible panel ids
  sidebarCollapsed Boolean   @default(false)
  theme            String    @default("dark")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([userId])
  @@index([deletedAt])
}

// Sprint D2.7.11 Phase 1b - durable, cross-session persistence for chart
// drawn objects (trend lines, horizontal lines, rectangles, Fibonacci
// retracements - lib/chart-engine/drawing/types.ts's DrawingObject union).
// Previously sessionStorage only (lib/chart-engine/drawing/store.ts) - tab-
// scoped, gone on tab close. One row per (userId, symbol, timeframe) - the
// exact same compound key store.ts's sessionStorage entries already used -
// `objects` is the full JSON array for that key, always written as a
// whole-array replace (never per-object CRUD), matching NativeChart.tsx's
// existing commitDrawingObjects()/writeDrawingObjects() semantics exactly,
// so the client-side object model and component logic needed no redesign,
// only a swap from sync sessionStorage calls to async fetch calls.
model ChartDrawingSet {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  timeframe String
  objects   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol, timeframe])
  @@index([userId])
}

// Sprint D2.7.11 Phase 4 - saved chart templates (MT5's own real Template
// feature: a named, reusable bundle of active indicators + drawn objects).
// Deliberately NOT scoped by symbol/timeframe (unlike ChartDrawingSet
// above) - a template is meant to be applied to ANY chart, matching real
// MT5 template behavior exactly, including its own real limitation: a
// drawn object's price/time coordinates are reapplied as-is to whatever
// symbol/timeframe the template lands on, which can look nonsensical on a
// very different instrument - MT5 itself has this same limitation, so
// this isn't a shortfall to engineer around, just realistic parity.
// `indicatorKeys` stores only the DEFAULT_INDICATOR_CONFIGS `key` strings
// (e.g. "ema-20") - never a full duplicated IndicatorConfig - since the
// registry is the one canonical source for what a given key actually
// means. (userId, name) is unique - saving a template under an existing
// name is a deliberate upsert (overwrite), not a rejected duplicate.
model ChartTemplate {
  id             String   @id @default(cuid())
  userId         String
  name           String
  indicatorKeys  String[] @default([])
  drawingObjects Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

// Sprint D2.7.11 (post-completion, roadmap item 2) - durable, cross-
// session/cross-device persistence for the Phase 3 multi-symbol tiled
// layout (provider/layout/panes/primaryPaneIndex - lib/chart-engine/
// chart-session-state.ts's ChartSessionState shape). Previously
// sessionStorage only - tab-scoped, gone on tab close/new device - the
// exact same "prove it in session storage first" precedent
// ChartDrawingSet followed before it earned a real table (Phase 1 ->
// 1b). One row per user (`userId` unique) - a single durable "your
// current tiled workspace", matching how WorkspacePreference already
// keeps one row per user for symbol/profile/favorites; a separate
// named-multiple-layouts feature would be its own distinct ask, not
// fabricated here. `panes` stores the full ChartPaneSessionState[]
// JSON array (symbol/timeframe/indicatorKeys per pane) - always
// written as a whole-array replace, matching ChartDrawingSet's own
// established "here is the new full state" semantics.
model ChartWorkspaceLayout {
  id               String   @id @default(cuid())
  userId           String   @unique
  provider         String   @default("native")
  layout           Int      @default(1)
  panes            Json     @default("[]")
  primaryPaneIndex Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Sprint D2.3.S1 - Publishing Activation. Real, DB-backed article state:
// before this, the Publishing dashboard rendered hardcoded mock data with no
// persistence and no working Publish/Schedule actions (Master Audit D2.3.F,
// Critical finding #1). Website-channel scope only for this pass - no
// Telegram/Twitter/LinkedIn/newsletter/RSS dispatch (see
// services/ai/publishing/publisher.service.ts's SUPPORTED_CHANNELS, which
// stays a reference list for a future multi-channel pass; runJob() there
// remains a documented placeholder). `history` is an append-only log
// (create/generate/edit/schedule/publish/delete), same lightweight pattern
// WorkflowRun.log already uses in this schema - this is what makes the
// audit's "History" finding real rather than another status flag.
enum ArticleStatus {
  draft
  scheduled
  published
  failed
}

// Architectural constraint (not yet full version-history, deliberately -
// see services/publishing/article.service.ts's update()): once `status` is
// `published`, this row is read-only - the service layer rejects further
// edits rather than letting a published article silently change under a
// reader who already saw it. Revising means duplicateAsDraft() (a new row),
// never an in-place edit. If a full version-history table is ever needed
// (e.g. to show a diff between revisions), this is the seam to add it at -
// the read-only guarantee above means today's single-row model is already
// a safe foundation for that, not a shortcut that would need undoing.
model Article {
  id           String        @id @default(cuid())
  userId       String
  title        String
  category     String
  summary      String        @default("")
  sections     Json          @default("[]") // ArticleSection[]
  disclaimer   String        @default("This is not financial advice. Trading involves risk.")
  seo          Json          @default("{}") // SeoMetadata (title/metaDescription/keywords/slug/canonicalUrl/openGraph/twitter/score)
  slug         String
  status       ArticleStatus @default(draft)
  sourceType   String        @default("manual") // "ai" | "manual" | "imported" | "research"
  scheduledFor DateTime?
  publishedAt  DateTime?
  history      Json          @default("[]") // { action, actor, timestamp, metadata? }[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@unique([userId, slug])
  @@index([userId])
  @@index([userId, status])
  @@index([deletedAt])
  @@map("articles")
}

// Sprint D2.5.1 - Persistent Analysis & Outcome Foundation (Intelligence
// Engine V2, phase 1). Deliberately distinct from the existing, in-memory-
// only `AnalysisRun` domain type (services/ai/analysis-run.service.ts,
// types/analysis-run.ts) - that one tracks a single orchestration API call
// (pending/completed/unavailable/failed) and is NOT being replaced or
// touched here. This model is the new, durable Intelligence Memory record:
// it persists a completed deterministic analysis snapshot so it can later
// be compared against what actually happened in the market. Named
// `IntelligenceAnalysisRun`/`IntelligenceAnalysisOutcome` (not bare
// `AnalysisRun`/`AnalysisOutcome`) specifically to avoid the exact kind of
// name collision this codebase has repeatedly flagged and avoided
// elsewhere (types/market-analysis.ts vs types/market-analysis-
// orchestration.ts; types/market-intelligence.ts vs types/market-
// intelligence-result.ts).
//
// `analysisResult` stores the real, deterministic `MarketIntelligenceResult`
// (evidence + reasoning + risk + confidence - zero AI-authored content) as
// JSON - never the Gemini-touched `MarketAnalysisResult.summary`, per the
// sprint's rule that no LLM output may create or modify these facts.
// `regimeAtTime` is always null in D2.5.1: no Regime Engine exists yet
// (confirmed by the D2.5.0 audit) - typed as Json, not a real Regime shape,
// so a future sprint can populate it without a breaking schema change.
//
// Sprint D2.5.4 - added `hypothesisSnapshot` (additive, nullable): the
// real, complete D2.5.2/D2.5.3 MarketState + Regime + Hypothesis[] as they
// existed AT CREATION TIME, stored as JSON (types/intelligence-hypothesis-
// snapshot.ts#HypothesisSnapshot). This is the "creation-time snapshot"
// the D2.5.4 evaluator reads from - it never recalculates the original
// hypothesis from today's market state. `regimeAtTime` above stays
// untouched/still-always-null; the richer snapshot lives in this new,
// separate column rather than repurposing that one, so its own
// documented meaning ("reserved for a future Regime Engine's raw output")
// isn't redefined out from under it.
enum IntelligenceAnalysisRunEvaluationStatus {
  pending
  evaluated
}

model IntelligenceAnalysisRun {
  id                 String                                  @id @default(cuid())
  userId             String
  symbol             String
  timeframe          String
  // Real value from MarketIntelligenceResult.metadata.pipelineVersion (e.g.
  // "15D.12.0") when analysisResult is present; null when it isn't - never
  // invented.
  pipelineVersion    String?
  // The real, deterministic MarketIntelligenceResult snapshot (JSON). Null
  // only when genuinely unavailable (e.g. a provider-unavailable run) -
  // never a fabricated placeholder.
  analysisResult     Json?
  // Always null in D2.5.1 - see header comment. Reserved for a future
  // Regime Engine's real output.
  regimeAtTime       Json?
  // Sprint D2.5.4 - the real, complete MarketState + Regime + Hypothesis[]
  // creation-time snapshot (HypothesisSnapshot). Null for runs created
  // before D2.5.4, or any run with no real hypothesis to snapshot.
  hypothesisSnapshot Json?
  evaluationStatus   IntelligenceAnalysisRunEvaluationStatus @default(pending)
  createdAt          DateTime                                @default(now())
  deletedAt          DateTime?

  outcomes IntelligenceAnalysisOutcome[]

  @@index([userId])
  @@index([symbol])
  @@index([evaluationStatus])
  @@index([deletedAt])
  @@map("intelligence_analysis_runs")
}

enum IntelligenceAnalysisOutcomeStatus {
  pending
  validated
  invalidated
  inconclusive
}

// D2.5.1 had no Hypothesis Engine, so "validated"/"invalidated" were
// structurally unreachable then - see services/intelligence/memory/
// outcome-evaluator.service.ts (still true for that evaluator, which
// remains unchanged). Sprint D2.5.4 adds a second, hypothesis-aware
// evaluator (services/intelligence/hypothesis/hypothesis-outcome-
// evaluator.service.ts) that DOES reach validated/invalidated for real,
// once a hypothesisId/hypothesisType/regimeType are genuinely known.
model IntelligenceAnalysisOutcome {
  id                 String                            @id @default(cuid())
  analysisRunId      String
  // Real (matches a Hypothesis.id from the parent run's hypothesisSnapshot)
  // as of D2.5.4, when the outcome evaluates a real hypothesis. Still null
  // for outcomes produced by D2.5.1's original, hypothesis-unaware
  // evaluator.
  hypothesisId       String?
  // Sprint D2.5.4 - denormalized from the evaluated Hypothesis/Regime at
  // evaluation time, purely for efficient historical-validation
  // segmentation (services/intelligence/memory/historical-validation
  // .service.ts) - never a second, independently-editable source of
  // truth; always copied from the real hypothesisSnapshot, never entered
  // separately.
  hypothesisType     String?
  regimeType         String?
  evaluatedAt        DateTime?
  status             IntelligenceAnalysisOutcomeStatus @default(pending)
  // Real, computed only when a price-type evidence item at analysis time
  // AND a real current snapshot are both available - never estimated.
  actualPriceMovePct Float?
  // Always null in D2.5.1 - no Regime Engine exists yet.
  actualRegimeAfter  Json?
  // Required, human-readable: always states exactly why this status was
  // assigned - never a bare score with no explanation. As of D2.5.4, a
  // JSON-serialized structured object for every non-"pending-from-
  // creation" outcome - see HypothesisEvaluationBasis.
  evaluationBasis    String
  createdAt          DateTime                          @default(now())

  analysisRun IntelligenceAnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId])
  @@index([status])
  @@index([createdAt])
  @@index([hypothesisType])
  @@index([regimeType])
  @@map("intelligence_analysis_outcomes")
}

// Sprint D2.7.9 - Historical Validation Production Wiring. A partial unique
// index (NOT expressible as a Prisma `@@unique` here - Prisma has no WHERE
// clause on indexes, so this is enforced only in the hand-written migration
// prisma/migrations/*_add_outcome_idempotency_guard/migration.sql) exists on
// intelligence_analysis_outcomes("analysisRunId", "hypothesisId") WHERE
// "hypothesisId" IS NOT NULL AND "status" IN ('validated', 'invalidated').
// This is the DB-level concurrency backstop for
// HypothesisOutcomeEvaluatorService.evaluateAnalysisRun()'s idempotency
// check: two concurrent evaluator invocations can no longer both persist a
// finalized verdict for the same hypothesis. "pending"/"inconclusive"
// outcomes are deliberately excluded from the constraint - they remain
// retryable by design (a transient provider failure deserves another real
// attempt on the next trigger run).

// Sprint D2.6.9 - Verified Intelligence Audit, Explainability & Answer
// Traceability. The immutable, per-presented-answer audit record - see
// types/intelligence-audit-trace.ts's header for the full contract this
// mirrors. Created only for a resolved real-time intelligence turn whose
// envelope was actually handed to the D2.6.8 AI Presenter Orchestrator;
// never mutated after creation (services/intelligence/audit/audit-trace
// .service.ts enforces create-only - no update method exists). userId is
// denormalized and indexed, not FK-constrained to User, matching
// IntelligenceAnalysisRun's own established convention above. No
// deletedAt - historical immutability means a later re-analysis creates
// a NEW row, it never soft-deletes or rewrites this one.
model IntelligenceAuditTrace {
  id                        String   @id @default(cuid())
  userId                    String
  conversationId            String?
  // Loose reference (like PersistedConversationContext.lastAnalysisRunId)
  // - not a hard FK, so this trace survives independently of the
  // analysis run's own lifecycle.
  analysisRunId             String?
  symbol                    String
  timeframe                 String
  queryType                 String
  completeness              String
  decisionState             String
  generatedAt               DateTime
  intelligenceEngineVersion String
  pipelineVersion           String
  // Real AuditMarketDataProvenance (provider/freshness/reliability/cross-
  // provider-validation) - never secrets, never a raw provider payload.
  marketData                Json
  // Full, immutable copies of the real envelope/decision-context at
  // analysis time - see types/intelligence-audit-trace.ts's header for
  // why this pair, and only this pair, is stored in full.
  envelopeSnapshot          Json
  decisionContextSnapshot   Json
  relevanceBasis            Json
  missingContext            Json
  // Real AuditPresenterTrace (provider attempts, safe integrity-
  // violation-kind vocabulary only, fallbackUsed) - never raw provider
  // error text, never an API key.
  presenterTrace            Json
  integrityResult           Json
  claimTrace                Json
  responseGeneratedAt       DateTime
  createdAt                 DateTime @default(now())
  version                   String

  @@index([userId])
  @@index([conversationId])
  @@index([analysisRunId])
  @@index([createdAt])
  @@map("intelligence_audit_traces")
}

// ============================================================================
// AN1 - AI News Establishment. Real news pipeline (Alpha Vantage primary,
// CryptoPanic crypto-secondary), replacing the static data/news.ts feed - see
// docs/AN1-*.md for the full R&D/design record (provider decision, ingestion
// architecture, relevance mapping, classification).
//
// NewsArticle is a provider-independent normalized record: `provider`/
// `providerArticleId` identify the source, `rawPayload` is an untouched
// escape hatch for reprocessing (never the application contract). Sentiment
// is preserved exactly as the provider returned it (including hyphenated
// labels like "Somewhat-Bullish" - never normalized/rewritten). `category`/
// `impactLevel` are AT24's OWN derived fields, kept structurally separate
// from provider-native sentiment/relevance so the two can never be confused.
// `assetTags` is AT24's final relevance mapping (deterministic pipeline:
// native ticker match -> topic-derived -> keyword-inferred -> optional AI
// enrichment, the last currently OFF); `tagProvenance` preserves WHY each
// tag was assigned, since "why was this shown to me" matters once this is
// user-facing.
model NewsArticle {
  id                String    @id @default(cuid())
  provider          String
  providerArticleId String?
  dedupeKey         String    @unique

  headline          String
  summary           String?
  url               String?
  sourceName        String?

  publishedAt       DateTime?
  fetchedAt         DateTime  @default(now())

  // Provider-native output, stored as-is - never AT24's own classification.
  sentimentScore    Float?
  sentimentLabel    String?
  relevanceByAsset  Json?

  // AT24-derived, explicitly separate from the above:
  category          String?
  impactLevel       String?
  assetTags         String[] @default([])
  tagProvenance     Json?

  processingStatus  NewsProcessingStatus @default(pending)
  errorState        String?

  rawPayload        Json?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([provider])
  @@index([publishedAt])
  @@index([processingStatus])
  @@index([deletedAt])
  @@map("news_articles")
}

enum NewsProcessingStatus {
  pending
  processed
  failed
}

// Authoritative daily reservation for provider call budgets (e.g. Alpha
// Vantage's free-tier 25/day). `dailyLimit` is snapshotted per (provider,
// date) row at first-reservation time, so a mid-day config change affects
// tomorrow's row, never retroactively distorts today's. Reservation MUST use
// an atomic conditional upsert (see services/news/quota.service.ts) - a
// plain count-then-insert is a real TOCTOU race under concurrent cron/
// on-demand callers.
model ProviderQuota {
  provider   String
  date       String // "YYYY-MM-DD", UTC
  usedCount  Int      @default(0)
  dailyLimit Int
  updatedAt  DateTime @updatedAt

  @@id([provider, date])
  @@map("provider_quotas")
}

// Append-only audit trail of every real provider call attempt (successful or
// not). Distinct from ProviderQuota (the reservation ledger) - this exists
// for observability/debugging, not quota enforcement.
model ProviderCallLog {
  id           String   @id @default(cuid())
  provider     String
  purpose      String // "scheduled-ingestion" | "on-demand-fallback"
  calledAt     DateTime @default(now())
  success      Boolean
  errorMessage String?

  @@index([provider])
  @@index([calledAt])
  @@map("provider_call_logs")
}

// ============================================================================
// Sprint M8 - AT24 Marketplace. Additive-only; NOT applied to the live
// database this sprint (schema drafted + migration generated, not run -
// see ea-research/marketplace-research/m8-marketplace-platform/ for the
// full architecture audit and the reasoning below). Deliberately NOT
// connected to Product (which continues to power /products, untouched) -
// these are two parallel catalogs by design this sprint, not one migrated
// into the other. See M8_entity_relationship.md for the complete reasoning.
//
// tradingSystemId/versionId are plain identifier strings, not live Prisma
// relations: TradingSystem/Version/Evidence/Validation/RiskAnalysis/
// HistoryEvent/TrustStatus all remain M1_schema.prisma drafts (never
// applied to this file, across M1-M7) - there is nothing in this database
// to point a real foreign key at yet. Same reasoning for evidenceId/
// validationId/riskAnalysisId: pointers into the M2-M7 flat-file artifacts,
// not copies of their contents - this model never duplicates Evidence,
// Validation, RiskAnalysis, History, TrustStatus, or Score content.
//
// No evidenceTier field: blocked on ARCH-M1-TRUST-002 (M1's original
// BACKTEST_VERIFIED/.../AT24_VERIFIED tier vocabulary vs. M7's
// UNVERIFIED/.../SUPERSEDED trust-state vocabulary - two different,
// not-yet-reconciled concepts, documented not resolved here).
//
// trustState/publicationState are two separate columns on purpose (M8
// brief section 17/25) - a listing can be PUBLISHED with
// trustState=INCONCLUSIVE; the two are never equated in this sprint's code.
model MarketplaceListing {
  id   String @id @default(cuid())
  slug String @unique

  // --- Seller-authored presentation fields ---------------------------------
  // AT24-controlled fields (below) are never seller-writable; enforced in
  // the service/API layer, not just by convention - see
  // MarketplaceListingService and the marketplace API route handlers.
  sellerId    String
  title       String
  description String   @default("")
  media       String[] @default([])
  pricing     Json     @default("{}")
  category    String   @default("") // strategy category tag (trend/breakout/mean-reversion/liquidity/etc.)
  platformTag String   @default("") // MT5 / MT4 / cTrader / NinjaTrader / Crypto / AI Engine
  assetTag    String   @default("") // Gold / Silver / Forex / Indices / Crypto / etc.
  tags        String[] @default([])

  // --- Identity references (plain strings, not live FKs - see model comment) ---
  tradingSystemId String?
  versionId       String?

  // --- AT24-computed reference + outcome fields (never seller-writable) ---
  evidenceId       String?
  evidenceHash     String?
  validationId     String?
  validationHash   String?
  riskAnalysisId   String?
  riskAnalysisHash String?
  trustState       String? // M7 vocabulary: UNVERIFIED|VALIDATION_PENDING|INCONCLUSIVE|LIMITED|UNDER_OBSERVATION|VALIDATED|INVALIDATED|SUPERSEDED
  trustReasonCode  String?
  trustExplanation String    @default("")
  trustStatusId    String?
  lastEvidenceAt   DateTime? // observedAt of the most recent Evidence referenced above - a timestamp, not evidence content; lets catalog sort by "Most Recent Evidence" (M8 section 20) without joining the full Evidence record

  // --- Marketplace workflow state - separate axis from trustState ---------
  publicationState String @default("DRAFT") // DRAFT|SUBMITTED|UNDER_REVIEW|EVIDENCE_PENDING|VALIDATION_PENDING|READY|PUBLISHED|SUSPENDED|RETIRED

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([sellerId])
  @@index([publicationState])
  @@index([trustState])
  @@index([platformTag])
  @@index([assetTag])
  @@index([category])
  @@index([deletedAt])
  @@map("marketplace_listings")
}

// ── Sprint M11: License & Product Protection Architecture ──────────────
// Purely additive: five new tables, zero changes to any existing table,
// column, or constraint. NOT applied to the live database this sprint -
// migration.sql exists but running it requires a separate, explicit
// go-ahead (see M11_license_product_protection.md "Production Safety").
//
// Chain: MarketplaceListing -> ReleaseArtifact (one specific downloadable
// build) -> Purchase (a buyer bought a listing) -> Entitlement (buyer is
// authorized for a TradingSystem/platform, derived from a Purchase) ->
// License (a signed, revocable grant against one Entitlement) ->
// Activation (one device bound to one License). Deliberately parallel to,
// and never merged with, the Evidence/Validation/RiskAnalysis/History/
// TrustStatus chain: License answers "is this buyer authorized," Trust
// answers "how trustworthy is the product," Eligibility (M9) answers "is
// AT24 allowing this product to be sold." See M11_architecture.md section 1.
//
// Cross-domain references (buyerId -> User, marketplaceListingId ->
// MarketplaceListing, tradingSystemId/versionId -> the not-yet-real M1
// TradingSystem/Version) are plain, unconstrained strings, matching
// MarketplaceListing's own established convention (see that model's
// comment) - relations are only declared AMONG these five new models,
// which are introduced together in this same sprint (same pattern as
// Conversation/Message).

model ReleaseArtifact {
  id                   String    @id @default(cuid())
  tradingSystemId      String
  versionId            String
  marketplaceListingId String?
  platform             String
  artifactVersion      String
  artifactHash         String
  // DRAFT|PUBLISHED|DEPRECATED|REVOKED - a compromised release (Section 15/17)
  // is marked REVOKED here, never deleted; RuntimeValidation must reject it.
  releaseStatus        String    @default("DRAFT")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  licenses License[]

  // A given exact binary (by hash) for a given TradingSystem/Version/platform
  // is one release, once - a new binary is always a new row, never an
  // overwrite (Section 2: "A new binary must never silently replace an old
  // release").
  @@unique([tradingSystemId, versionId, platform, artifactHash])
  @@index([marketplaceListingId])
  @@index([platform])
  @@index([releaseStatus])
  @@index([deletedAt])
  @@map("release_artifacts")
}

model Purchase {
  id                   String    @id @default(cuid())
  buyerId              String
  marketplaceListingId String
  tradingSystemId      String
  amount               Float     @default(0)
  currency             String    @default("USD")
  // Null until a real payment flow exists - never fabricated (mirrors
  // Subscription.provider's own honesty convention above).
  provider             String?
  providerRef          String?   @unique
  status               String    @default("PENDING") // PENDING|COMPLETED|REFUNDED|REVERSED
  purchasedAt          DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  entitlements Entitlement[]

  @@index([buyerId])
  @@index([marketplaceListingId])
  @@index([status])
  @@index([deletedAt])
  @@map("purchases")
}

model Entitlement {
  id                   String    @id @default(cuid())
  purchaseId           String
  buyerId              String
  tradingSystemId      String
  marketplaceListingId String
  platform             String
  status               String    @default("ACTIVE") // ACTIVE|REVOKED
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  purchase Purchase  @relation(fields: [purchaseId], references: [id])
  licenses License[]

  @@index([buyerId])
  @@index([purchaseId])
  @@index([status])
  @@index([deletedAt])
  @@map("entitlements")
}

model License {
  id                   String    @id @default(cuid())
  entitlementId        String
  buyerId              String
  tradingSystemId      String
  versionId            String
  releaseId            String
  platform             String
  // ISSUED|ACTIVE|SUSPENDED|REVOKED|EXPIRED - see licenseStateMachine.ts for
  // the deterministic, fail-closed transition table.
  licenseStatus        String    @default("ISSUED")
  licenseSchemaVersion String    @default("M11-license-v1")
  activationPolicy     Json // { maxActivations: number } - see types/license.ts
  issuedAt             DateTime  @default(now())
  expiresAt            DateTime?
  revokedAt            DateTime?
  revokedReason        String?
  // Base64 Ed25519 signature over the canonical license payload - see
  // services/licensing/crypto.ts. Tamper-evident: any field change breaks
  // verification against the public key embedded in the product runtime.
  signature            String
  // Hashed at rest (never the raw key - see crypto.ts hashApiKey). The
  // credential a RUNTIME product presents to /api/license/* - NOT a browser
  // session (see M11_api_contract.md "Authentication"). The raw key is
  // returned to the buyer exactly once, at issuance, never stored or shown
  // again.
  apiKeyHash           String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  entitlement Entitlement     @relation(fields: [entitlementId], references: [id])
  release     ReleaseArtifact @relation(fields: [releaseId], references: [id])
  activations Activation[]

  @@index([entitlementId])
  @@index([buyerId])
  @@index([releaseId])
  @@index([licenseStatus])
  @@map("licenses")
}

model Activation {
  id              String    @id @default(cuid())
  licenseId       String
  // Platform-specific stable device identity, produced by a PlatformAdapter
  // (never a raw machine ID alone - see services/licensing/adapters/).
  deviceBindingId String
  deviceLabel     String    @default("")
  status          String    @default("ACTIVE") // ACTIVE|DEACTIVATED
  activatedAt     DateTime  @default(now())
  deactivatedAt   DateTime?
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  license License @relation(fields: [licenseId], references: [id])

  // Re-activating the same device on the same license is idempotent (Section
  // 19 test K/L: duplicate/replayed activation), enforced here at the DB
  // level, not just in application logic.
  @@unique([licenseId, deviceBindingId])
  @@index([licenseId])
  @@index([status])
  @@map("activations")
}

// ── Sprint M12 branding follow-on: real Evidence/Validation/Risk/Trust
// storage, replacing the flat-file convention (data/marketplace-evidence/
// *.json) two things depended on: mt5EvidenceAdapter.ts's discoverMt5Evidence
// (drives the real Submit-for-review eligibility check) and
// MarketplaceCatalogue.ts's detail-page Evidence/Validation/Risk/History
// sections. One row per tradingSystemId+versionId - deliberately NOT a
// normalized multi-table model (Evidence/Validation/RiskAnalysis/TrustStatus
// as separate tables, each own PK/FK) like the M1 schema draft
// (ea-research/marketplace-research/M1_schema.prisma) sketches - that draft
// was never wired to this schema or any live data and adopting it wholesale
// would mean redesigning the already-shipped M8/M9/M11 MarketplaceListing
// model too. This is the smallest real step that gets every product off
// hand-copied JSON files and onto one source of truth, so it stops breaking
// silently in unrelated ways (see the outputFileTracingIncludes fix this
// same session - a class of bug this table removes entirely).
//
// Still written only by an AT24 human running the real M2-M7 engines and
// then a loader script (scripts/load-marketplace-evidence.ts) - sellers
// have no write path to this table, same trust boundary as the files it
// replaces. Automating the M2-M7 computation itself (not just its storage)
// is a separate, much larger project - see this session's own discussion.
model MarketplaceEvidenceRecord {
  id              String @id @default(cuid())
  tradingSystemId String
  versionId       String

  // Discovery/eligibility fields - the exact shape
  // mt5EvidenceAdapter.ts's MT5EvidenceSnapshot already used, now as real
  // columns instead of a JSON file's top level.
  evidenceId              String
  evidenceHash            String
  validationId            String
  validationHash          String
  riskAnalysisId          String
  riskAnalysisHash        String
  trustState              String
  trustReasonCode         String
  trustExplanation        String    @default("")
  trustStatusId           String
  lastEvidenceAt          DateTime?
  validationOverallStatus String
  riskStatus              String

  // Full content for the listing detail page - the exact shape
  // MarketplaceCatalogue.ts's EvidenceContent already used.
  evidenceContent   Json
  validationContent Json
  riskContent       Json
  historyContent    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tradingSystemId, versionId])
  @@index([tradingSystemId])
  @@map("marketplace_evidence_records")
}

// Real, persisted observation history - the actual fix for the "UNDER_
// OBSERVATION forever" problem M7's own trust_status_engine.py always had:
// run_trust_status's own history_chain was built FRESH in-memory on every
// single script run and never saved anywhere, so re-running the same
// computation on the same Evidence could never accumulate real
// observations over time - there was no persistence layer for it to
// accumulate INTO. This table is that layer. One real row per genuinely
// distinct (tradingSystemId, versionId, evidenceId, riskAnalysisId)
// combination - the @@unique constraint is what makes this honest:
// re-loading the exact same computation twice (e.g. re-running a script)
// does NOT create a second observation, only a genuinely new evidenceId
// or riskAnalysisId (a real re-verification at a real later point in
// time) does. scripts/load-marketplace-evidence.ts is the only writer;
// it counts real distinct rows here and only upgrades trustState to
// VALIDATED when the count reaches M7's own MIN_OBSERVATIONS_FOR_VALIDATED
// (2) AND the underlying validation/risk status independently qualify -
// mirrors trust_status_engine.py's derive_trust_status precedence
// (Python stays authoritative for the base per-run decision; this is only
// the observation-count layer Python could never persist on its own).
model MarketplaceObservation {
  id              String   @id @default(cuid())
  tradingSystemId String
  versionId       String
  evidenceId      String
  riskAnalysisId  String
  observedAt      DateTime @default(now())

  @@unique([tradingSystemId, versionId, evidenceId, riskAnalysisId])
  @@index([tradingSystemId, versionId])
  @@map("marketplace_observations")
}

// Paper Trading Engine, Phase P1 - a fully isolated, database-only
// simulation (no real money, no live-account connectivity, never touches
// the real Exness/MT5 account). One account per user, real leverage/margin
// math, market orders filled at the REAL live bid/ask (never mid-price -
// see services/paper-trading/paper-trading.service.ts). Phase P2 (limit
// orders + automatic margin-call/stop-out) is now also shipped - see this
// file's own PaperPosition comment and
// docs/architecture/D2.7.11-native-chart-mt5-feature-parity-roadmap.md's
// paper-trading section.
model PaperTradingAccount {
  id        String          @id @default(cuid())
  userId    String          @unique
  balance   Float           @default(10000)
  leverage  Int             @default(100)
  createdAt DateTime        @default(now())
  resetAt   DateTime        @default(now())
  positions PaperPosition[]
}

// Phase P2 additions - orderType/limitPrice/filledAt/closeReason, and
// entryPrice/marginUsed are now NULLABLE: a "pending" limit order has
// neither yet (real MT5 behavior - a pending order's margin is estimated
// from its own limitPrice, computed at PLACEMENT time via
// paper-trading.service.ts's own openPosition(), not left uncounted; its
// real entryPrice is only set once the market genuinely reaches
// limitPrice - see fillPendingLimitOrders(), triggered by real price
// observations on /api/private/market-data/snapshot, never a background
// poll of its own). closeReason distinguishes a real user-initiated close
// ("manual") from an automatic one ("stop_out", checkStopOut()) - never
// silently identical, so a user can tell their position was force-closed.
model PaperPosition {
  id          String              @id @default(cuid())
  accountId   String
  account     PaperTradingAccount @relation(fields: [accountId], references: [id])
  symbol      String
  side        String
  orderType   String              @default("market")
  quantity    Float
  limitPrice  Float?
  entryPrice  Float?
  marginUsed  Float?
  status      String              @default("open")
  exitPrice   Float?
  realizedPnl Float?
  closeReason String?
  openedAt    DateTime            @default(now())
  filledAt    DateTime?
  closedAt    DateTime?

  @@index([accountId, status])
  @@index([symbol, status])
}

// P4.8-T2.2 - Strategy Persistence (docs/P4.8-T2.2-STRATEGY-PERSISTENCE.md).
// User-owned, AI-COMPILED strategies only - registry strategies
// ("golden", "ref-ema-crossover") are deliberately NEVER given a row
// here (the P4.8-T2.1 audit's own finding: they are global, code-owned,
// not user-owned - the registry itself already IS their source of
// truth; duplicating them here would create a second, driftable copy).
//
// `strategyId` is the P4.8-T1 stable, per-user, content-addressed AI
// identity (`ai-${userId}-${computeCrossPlatformSemanticHash(ir)}`) -
// `@@unique([userId, strategyId])` is what makes this an upsert target:
// recompiling byte-identical trading logic (even with different LLM
// phrasing/generated name - see P4.8-T1) reuses the SAME row, it never
// creates a duplicate.
//
// `artifact` is the engine's own, already-existing, already-tested
// StrategyVersionRecord (at24-quant-engine/src/domain/strategy-version.ts,
// Q0.9/ADR-007) - `{ strategyId, version, spec, publishedAt, contentHash }`.
// `spec` inside it is the FULL, executable StrategySpec (frozen via
// freezeStrategyVersion()) - re-runnable without ever asking the LLM to
// reconstruct trading logic again. This is deliberately NOT the same
// thing as AlgoTestRun.compiledStrategy below (that field is a
// human-readable presentation VIEW, AlgoTestCompiledStrategyView, and
// cannot be executed - see the P4.8-T2.1 audit's own finding).
model Strategy {
  id         String   @id @default(cuid())
  userId     String
  strategyId String
  // A plain string, not an enum - "ai-generated" is the only value today,
  // matching AlgoTestRun.status's own established convention (a future
  // origin needs no migration to add).
  origin     String
  name       String
  artifact   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  runs AlgoTestRun[]

  @@unique([userId, strategyId])
  @@index([userId, createdAt])
}

// P3.2B - Algo Testing (Pro). One row per deterministic backtest run
// against the canonical at24-quant-engine (docs/P3.1-*, P3.2A-*,
// P3.2B-ALGO-TEST-E2E.md). Deliberately does NOT persist the historical
// candles used (only metrics/trades/equityCurve - small, bounded by the
// service's own MAX_RANGE_DAYS validation) - "do not store unnecessarily
// huge raw datasets" (P3.2B brief SS16). Never stores provider API
// credentials - those live only in TWELVEDATA_API_KEY server env, never
// touch this row. `strategyId` is a stable identifier ("golden" today),
// never the full StrategySpec - the spec itself lives in
// at24-quant-engine's own src/reference/golden-strategy.ts, single
// source of truth, never duplicated into the DB.
model AlgoTestRun {
  id             String    @id @default(cuid())
  userId         String
  strategyId     String
  // P3.3 - the exact registered version of `strategyId` this run was
  // executed against (services/algo-test/strategy-registry.ts), so a
  // historical row stays identifiable even if the registry later adds a
  // newer version of the same strategyId. Nullable: rows created before
  // P3.3 (strategyId "golden" only, single version in existence at the
  // time) genuinely predate this field - never backfilled with a guess.
  strategyVersion String?
  symbol         String
  timeframe      String
  startTime      DateTime
  endTime        DateTime
  initialBalance Float
  status         String
  resultHash     String?
  // P3.3 - result-contract version (this row's own field-shape identity)
  // and the at24-quant-engine runtime version that actually produced this
  // result (SimulationResult.provenance.runtimeVersion, read verbatim -
  // never a duplicated literal). Both null for pre-P3.3 rows and for a run
  // that never reached a completed engine result.
  resultVersion  String?
  engineVersion  String?
  // P3.4 - the exact, fully-normalized parameter configuration (every
  // declared parameter present, defaults filled in) this run actually
  // executed with - an immutable snapshot of what was used, never
  // re-derived from the registry after the fact. Null for a run whose
  // strategy has no declared parameters AND for every pre-P3.4 row
  // (never backfilled with a guessed value - see
  // docs/P3.4-STRATEGY-PARAMETERS.md's backward-compatibility section).
  parameters     Json?
  metrics        Json?
  trades         Json?
  equityCurve    Json?
  assumptions    Json?
  // P4.5 - Strategy & Run Identity Persistence. All three were already
  // COMPUTED on every request since P3.8/P4.3 (buildRunLifecycle /
  // toCompiledStrategyView / computeSemanticStrategyHash) but never
  // written to this row - a disclosed P4.3 gap: a reopened run genuinely
  // could not show them. Written exactly once, at the same update() call
  // that already sets metrics/trades/equityCurve above - never a second
  // write, never recomputed differently after the fact. Nullable: every
  // pre-P4.5 row genuinely predates this field and is never backfilled
  // with a guess, same convention as `parameters` (P3.4) above.
  //
  // strategyHash: the semantic identity of the exact StrategySpec this
  // run executed (computeSemanticStrategyHash - excludes metadata,
  // INCLUDES risk/parameter values, since those are nested StrategySpec
  // fields). Deliberately reuses this one, already-real, already-wired
  // function - not the separate, still-unconsumed
  // computeStrategyIdentityHash/computeExperimentIdentityHash the engine
  // also declares (Q0.2.10/Q0.2.12 - reserved for a future
  // experiment/optimization identity, out of P4.5's bounded scope).
  // Indexed (see @@index below) so a future run-history/library/
  // optimization feature can group or compare runs by exact strategy
  // identity without a new abstraction.
  strategyHash     String?
  // lifecycle: the full 8-stage StrategyLifecycleResult (P3.8) this run
  // reached, exactly as first computed - not re-derived from strategyId
  // after the fact (a later registry change must never alter a past
  // run's own recorded lifecycle).
  lifecycle        Json?
  // compiledStrategy: the human-readable AlgoTestCompiledStrategyView
  // (P4.3) of the exact resolved StrategySpec this run executed.
  compiledStrategy Json?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  // P4.8-T2.2 - a nullable reference to the persisted Strategy this run
  // was compiled from, wired ONLY for new AI runs going forward.
  // Deliberately `SetNull` on delete, never `Cascade` - run history is
  // historical evidence and must survive a Strategy being edited/deleted
  // later (that UX does not exist yet, but the constraint is set now so
  // it can never accidentally become destructive). Every pre-T2.2 row -
  // and every registry-strategy row, forever, since registry strategies
  // never get a Strategy row at all - has this genuinely NULL, never
  // backfilled or guessed.
  strategyRefId  String?
  strategy       Strategy? @relation(fields: [strategyRefId], references: [id], onDelete: SetNull)
  // P4.9-A - a nullable reference to the OptimizationCandidate this run
  // executed on behalf of, when this run exists BECAUSE an optimization
  // chunk claimed and ran that candidate (candidates reuse this exact
  // table for their actual simulation execution/trades/equityCurve/
  // metrics, never a duplicate storage path). NULL for every ordinary,
  // non-optimization run - the overwhelming majority of rows, forever.
  // Deliberately `SetNull`, same reasoning as `strategyRefId` above: a
  // run is historical evidence and must survive its originating
  // candidate/experiment being deleted later. `@unique` (locked P4.9-A
  // design) - at most one run per candidate, enforced at the DB level
  // rather than by application logic.
  experimentCandidateId String?                 @unique
  experimentCandidate   OptimizationCandidate?  @relation(fields: [experimentCandidateId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, strategyHash])
  @@index([strategyRefId])
}

// ============================================================================
// Sprint AN (Agent Framework Foundation) - A3: Agent Run persistence.
//
// The database-backed state machine for AF-v1 agent runs
// (types/agent-framework/agent-run-contract.ts). Deliberately NOT connected
// to the legacy Agent / AgentTask / AgentMemory / AgentActivity models - the
// AN-series decision (AN1.2 D3) treats those as a frozen legacy compatibility
// layer for the current /dashboard/agents UI. `agentId` / `userId` here are
// bare, indexed identifier strings with NO Prisma relation - the exact same
// convention AgentTask / AgentMemory / AgentActivity / IntelligenceAnalysisRun
// already use (a denormalized owner id, enforced in the service layer, never
// trusted from client input). Relations are declared ONLY among the four new
// models, which ship together in one migration (same pattern as
// Conversation/Message and the M11 license chain).
//
// AN1.2 invariant 2 (append-only immutable history): AgentStep, AgentToolCall
// and AgentEvidence have NO update path and NO soft-delete - a re-run is a
// new AgentRun row. Only AgentRun is mutable (status transitions per the
// AF-v1 RUN_STATUS_TRANSITIONS table) and soft-deletable.
//
// AN1.2 P1 / migration rule: this schema block is committed with a
// hand-reviewed migration SQL file that is GENERATED and REVIEWED but NOT
// APPLIED. Applying it needs a separate explicit go-ahead. Never `prisma
// migrate dev` (pgvector-reset trap).

enum AgentRunStatus {
  queued
  planning
  running
  awaiting_approval
  succeeded
  failed
  timeout
  credit_limit
  step_limit
  tool_call_limit
  permission_denied
  tool_error
  model_error
  cancelled
}

enum AgentRunTrigger {
  manual
  schedule
  event
  supervisor
}

enum AgentStepKind {
  plan
  tool_call
  evidence
  memory_read
  memory_write
  evaluation
  model_call
  output
}

enum AgentStepStatus {
  ok
  error
  skipped
}

// Mirrors AF-v1 ToolResultStatus exactly.
enum AgentToolCallStatus {
  ok
  invalid_input
  tool_error
  tool_timeout
  permission_denied
}

// Mirrors AF-v1 AgentEvidenceType exactly.
enum AgentEvidenceType {
  market_data
  indicator
  news
  regime
  backtest
  strategy_result
  research_document
  web_result
  risk_assessment
  derived
}

// One agent execution. Mutable ONLY for its status + terminal fields
// (errorCode/errorMessage/output/completedAt/creditsConsumed/resumeState);
// a terminal run is never rewritten. `limits` is the snapshot of the
// effective ceilings taken at creation (the LimitEnforcer reads this, never
// the live agent policy). `resumeState` is the opaque checkpoint the A4
// resumable tick() runtime uses - resumability is a property of the RUN,
// independent of any tool's own sync/resumable executionMode.
model AgentRun {
  id               String          @id @default(cuid())
  agentId          String
  agentVersion     String
  userId           String
  status           AgentRunStatus  @default(queued)
  trigger          AgentRunTrigger @default(manual)
  input            Json
  plan             Json?
  output           Json?
  errorCode        String?
  errorMessage     String?
  limits           Json
  creditsEstimated Float           @default(0)
  creditsConsumed  Float           @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  metadata         Json            @default("{}")
  resumeState      Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  steps     AgentStep[]
  toolCalls AgentToolCall[]
  evidence  AgentEvidence[]

  @@index([userId])
  @@index([agentId])
  @@index([agentId, createdAt])
  @@index([status])
  @@index([status, updatedAt])
  @@index([createdAt])
  @@index([deletedAt])
}

// One ordered entry in a run's execution history. Append-only, immutable:
// no updatedAt, no deletedAt. (runId, index) is unique - the index is
// 0-based, strictly increasing, gapless.
model AgentStep {
  id              String          @id @default(cuid())
  runId           String
  index           Int
  kind            AgentStepKind
  status          AgentStepStatus
  summary         String
  input           Json?
  output          Json?
  startedAt       DateTime
  completedAt     DateTime
  durationMs      Int
  creditsConsumed Float           @default(0)
  createdAt       DateTime        @default(now())

  run       AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolCalls AgentToolCall[]
  evidence  AgentEvidence[]

  @@unique([runId, index])
  @@index([runId])
  @@index([kind])
}

// One tool invocation through the ToolGateway. Append-only, immutable.
// Carries BOTH runId (for "all tool calls in this run" queries) and stepId
// (the step that made the call). `status` mirrors AF-v1 ToolResultStatus.
model AgentToolCall {
  id                String              @id @default(cuid())
  runId             String
  stepId            String
  toolId            String
  toolVersion       String
  input             Json
  output            Json?
  status            AgentToolCallStatus
  permissionChecked String[]            @default([])
  creditCost        Float               @default(0)
  startedAt         DateTime
  completedAt       DateTime
  durationMs        Int
  evidenceIds       String[]            @default([])
  createdAt         DateTime            @default(now())

  run      AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  step     AgentStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  evidence AgentEvidence[]

  @@index([runId])
  @@index([stepId])
  @@index([toolId])
}

// One cited piece of evidence. Append-only, immutable. Always linked to a
// run AND a step; linked to a tool call when a tool produced it. This is the
// table that answers "why did this agent produce this conclusion" without
// replaying logs. `provenance` is the AF-v1 EvidenceProvenance JSON (never a
// secret or a raw provider payload). `timestamp` = when the underlying fact
// was true; `createdAt` = row write time.
model AgentEvidence {
  id         String            @id @default(cuid())
  runId      String
  stepId     String
  toolCallId String?
  type       AgentEvidenceType
  claim      String
  source     String
  sourceId   String
  timestamp  DateTime
  data       Json
  relevance  Float
  confidence Float
  provenance Json
  createdAt  DateTime          @default(now())

  run      AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  step     AgentStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  toolCall AgentToolCall? @relation(fields: [toolCallId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([stepId])
  @@index([toolCallId])
  @@index([type])
}

// ============================================================================
// Sprint AN - A7: policy-gated agent memory.
//
// The AF-v1 memory contract (types/agent-framework/memory-contract.ts). This
// table backs SIX layers; RUN_STATE is deliberately NOT one of them - it is
// transient/resumable execution state and lives on AgentRun/AgentStep, it is
// not memory (owner G06 lock). Access is ONLY ever through the MemoryGateway
// (services/agent-framework/memory/), never direct - a tool handler cannot
// read or write this table.
//
// Deliberately NOT the legacy AgentMemory model (flat key/value String, part
// of the frozen legacy /dashboard/agents layer) - that is untouched. Also
// deliberately NOT the AT24 Knowledge/RAG system - this is small, bounded,
// per-agent scratch/experience storage, not a document/vector store.
//
// `agentId` / `userId` are bare indexed strings (no relation), same
// convention as every other AN table. `provenance.origin = "agent-derived"`
// writes to a knowledge layer (LONG_TERM / RESEARCH_MEMORY / STRATEGY_MEMORY)
// are FORCED to status `pending_approval` by resolveWriteDecision - an agent
// never silently promotes its own output into trusted knowledge.
//
// Migration status: GENERATED + REVIEWED, NOT APPLIED (same rule as A3).

enum AgentMemoryLayer {
  SHORT_TERM
  LONG_TERM
  USER_CONTEXT
  RESEARCH_MEMORY
  STRATEGY_MEMORY
  PERFORMANCE_MEMORY
}

enum AgentMemoryRecordStatus {
  active
  pending_approval
  expired
}

model AgentMemoryRecord {
  id         String                  @id @default(cuid())
  agentId    String
  userId     String
  runId      String?
  layer      AgentMemoryLayer
  scope      String
  key        String
  value      Json
  retention  Json
  provenance Json
  status     AgentMemoryRecordStatus @default(active)
  expiresAt  DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  deletedAt  DateTime?

  @@index([userId])
  @@index([agentId])
  @@index([userId, agentId, layer, scope, key])
  @@index([userId, layer, scope])
  @@index([status])
  @@index([expiresAt])
  @@index([deletedAt])
}

// ============================================================================
// Sprint AN - A9: the agent Credit Ledger.
//
// The ACCOUNTING authority for agent credit consumption - distinct from the
// per-run BUDGET guardrail (AgentRun.limits.maxCreditCost, enforced by A8/A4).
// Append-only + immutable: no updatedAt, no deletedAt, no update path. A
// re-run/retry never double-charges - `idempotencyKey` is unique, so a
// resumed tick() that re-attempts the same plan step reuses the existing
// entry instead of writing a second one.
//
// `amount` is signed: positive = debit (consumption), negative = refund /
// correction. `balanceAfter` is the balance computed AT WRITE TIME (advisory
// for audit); the AUTHORITATIVE balance is always
// PLAN_LIMITS[plan].aiCredits - SUM(amount) over the billing period, computed
// fresh. `runId` is always present; `stepId` / `toolCallId` correlate a
// charge to the exact tool call it paid for.
//
// This is NOT a pricing system (owner P3 / A9 lock): per-tool costs remain
// placeholder constants. A9 makes the ACCOUNTING real and auditable, nothing
// more. Pool-unification with the existing aiMessages entitlement
// (services/billing/*) is a deliberate follow-on, out of A9 scope.
//
// Migration status: GENERATED + REVIEWED, NOT APPLIED (same rule as A3/A7).

enum AgentCreditEntryKind {
  tool_call
  model_inference
  research_search
  backtest
  optimization
  large_context
  refund
  adjustment
}

model AgentCreditLedgerEntry {
  id             String               @id @default(cuid())
  userId         String
  runId          String
  stepId         String?
  toolCallId     String?
  kind           AgentCreditEntryKind
  /// Signed: positive = debit, negative = refund/correction.
  amount         Float
  /// Balance computed at write time (advisory; recompute for authority).
  balanceAfter   Float
  /// Unique - the double-charge guard for resumed/retried ticks.
  idempotencyKey String               @unique
  reason         String
  /// Billing-period boundary this entry counts against (denormalised so a
  /// period-sum query needs no join to Subscription).
  periodStart    DateTime
  createdAt      DateTime             @default(now())

  @@index([userId, periodStart])
  @@index([runId])
  @@index([userId, createdAt])
}

// ============================================================================
// Sprint AN - A10: run Evaluation + Observability.
//
// One immutable evaluation per terminal run. A10 does NOT re-check
// authorization (A8) or output integrity (A6) or credit accounting (A9) - it
// READS their recorded results from the persisted trace + ledger and SCORES
// them. Heuristic evaluator, deterministic, structured (not a log string).
//
// `scores` is the per-dimension AgentEvaluationScore[] JSON; `measurableSignals`
// is the flat observability payload (counts, wallMs, planningPath, ...).
// Written best-effort by the runtime at every terminal transition - an
// evaluation failure NEVER changes a run's outcome.
//
// Migration status: GENERATED + REVIEWED, NOT APPLIED (same rule as A3/A7/A9).

model AgentEvaluation {
  id                String   @id @default(cuid())
  runId             String   @unique
  agentId           String
  userId            String
  terminalStatus    String
  scores            Json
  compositeScore    Float
  failureCategory   String
  failureAnalysis   String
  measurableSignals Json
  evaluatorVersion  String
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([agentId])
  @@index([terminalStatus])
}

// P4.9-A (locked design, transcribed verbatim from the locked schema plus
// the explicitly-approved `strategyArtifactHash` addition below - see
// docs/P4.9-OPTIMIZATION-WFO.md). One row per requested grid sweep.
// Deliberately references `strategyId` as a plain string (the registry
// literal, e.g. "golden"), NEVER a `Strategy` relation - the P4.8
// `Strategy` model is AI-generated-only (see its own comment above), and
// P4.9-A's locked scope is registry strategies only. A future
// AI-parameterization phase can introduce its own separate relation;
// P4.9-A never assumes one exists.
model OptimizationExperiment {
  id                  String    @id @default(cuid())
  userId              String
  // Registry literal ("golden") - NOT a Strategy relation. Registry
  // strategies have no Strategy row.
  strategyId          String
  // ADDITIONAL field, explicitly required alongside the locked design
  // above: `computeSemanticStrategyHash(spec)` (already real, already
  // reused for `AlgoTestRun.strategyHash`) of the exact base StrategySpec
  // resolved from the registry at experiment creation time - frozen
  // once, never recomputed. Answers "which exact strategy artifact was
  // optimized?" - distinct from `fingerprint` below, which answers
  // "which exact optimization experiment/configuration was performed?"
  // and incorporates this hash as one of its own inputs (A.2 concern -
  // this column only stores the value, it does not compute it).
  strategyArtifactHash String
  symbol              String
  timeframe           String
  startTime           DateTime
  endTime             DateTime
  initialBalance      Float
  searchSpace         Json      // OptimizationParameterRange[] - {parameterId, min, max, step}
  objective           String    // "profitFactor" only in v1 - a real column, not hardcoded, for forward-compat
  minEligibleTrades   Int       // locked default 20, stored per-row (never hardcoded server-side)
  candidateCap        Int       // locked default 256, ditto
  totalCandidates     Int       // computed once at creation from searchSpace, persisted - never recomputed differently later
  processedCandidates Int       @default(0)
  status              String    // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  bestCandidateId     String?
  // computeCanonicalHash(...) over the full experiment configuration AND
  // execution semantics (P4.9-A.2 lock): strategyId, strategyArtifactHash,
  // searchSpace, objective, minEligibleTrades, candidateCap, symbol,
  // timeframe, startTime, endTime, initialBalance, engineVersion
  // (RUNTIME_VERSION, read before any candidate runs), executionModel
  // (dataFidelity/spreadModel/slippageModel/feeModel/latencyModel names).
  // strategyArtifactHash stays a SEPARATE column ("what was optimized");
  // this is "under exactly what conditions" - the stronger reproducibility
  // boundary. A.2 computes this once at creation; this column only stores
  // the resulting value, never recomputed later.
  fingerprint         String
  errorMessage        String?
  createdAt           DateTime  @default(now())
  completedAt         DateTime?
  // P4.9-A.2 - set only on the RUNNING/QUEUED -> CANCELLED transition
  // (cancelOptimizationExperiment(), an atomic conditional updateMany).
  // Deliberately NOT reusing `completedAt` for this - "this experiment
  // reached COMPLETED" and "this experiment was CANCELLED" are genuinely
  // different facts, kept in their own columns rather than one timestamp
  // whose meaning would depend on reading `status` alongside it.
  cancelledAt         DateTime?

  candidates OptimizationCandidate[]

  @@index([userId, createdAt])
}

// P4.9-A (locked design, transcribed verbatim). One row per grid point of
// an OptimizationExperiment. `candidateHash` -
// `computeCanonicalHash({ experimentId, parameterValues })` - deliberately
// NOT the primary key, so the opaque cuid stays stable while this stays
// independently verifiable/re-derivable for idempotent claiming: a
// retried execution chunk re-derives the identical `candidateHash` for
// the same grid point and finds the row already claimed/completed via
// the `@@unique([experimentId, candidateHash])` constraint below, rather
// than ever creating a duplicate.
model OptimizationCandidate {
  id              String    @id @default(cuid())
  experimentId    String
  experiment      OptimizationExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  candidateHash   String
  parameterValues Json
  status          String    // UNRUN | RUNNING | COMPLETED | REJECTED | CANDIDATE | VALIDATED
  tradeCount      Int?
  // See the Infinity note in docs/P4.9-OPTIMIZATION-WFO.md - this column
  // stores a real IEEE-754 double (Postgres handles Infinity natively);
  // the WIRE contract does not (P4.9-A.3 concern).
  profitFactor    Float?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  run AlgoTestRun?

  @@unique([experimentId, candidateHash])
  @@index([experimentId, status])
}

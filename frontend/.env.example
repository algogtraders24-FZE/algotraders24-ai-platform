# ---- Database (server-only) ----
DATABASE_URL=
DIRECT_URL=

# ---- Supabase (public, client-safe) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# ---- AI / Gemini (server-only) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.5-flash-lite

# ---- Market Data (server-only) ----
# Provider priority (Sprint D2.2): PRIMARY = Twelve Data, SECONDARY/fallback =
# Alpha Vantage. The central MarketDataService prefers Twelve Data and falls
# back to Alpha Vantage when it is unavailable. Both keys are server-only and
# must NEVER be exposed through a NEXT_PUBLIC_* variable. Placeholders only —
# never commit a real key.
TWELVEDATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ---- Payments (server-only) - Sprint L2.7 ----
# Both providers are optional: every payment route/health check reports an
# honest "not configured" state when its keys are absent, rather than
# fabricating a successful payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ---- Runtime config ----
REPOSITORY_MODE=auto
SLOW_QUERY_MS=300

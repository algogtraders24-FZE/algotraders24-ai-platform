# mt5-bridge/.env.example
# Copy to .env on the VPS (never commit the real .env). uvicorn/bridge.py
# reads MT5_BRIDGE_SECRET from the process environment - set it however
# you launch the service (a real .env loader, a Windows service's
# environment block, or a plain `set` before running uvicorn).

# A long, random shared secret - generate with e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The SAME value must be set as MT5_BRIDGE_SECRET in the Next.js app's
# Vercel environment variables.
MT5_BRIDGE_SECRET=
